module

public import Mathlib.Geometry.Manifold.SmoothEmbedding
public import SymplecticGeometry.Geometry.Symplectic.Flux.CompactSupport
import SymplecticGeometry.Geometry.Symplectic.Flux.Parametric
import SymplecticGeometry.Geometry.Symplectic.IsotopyExtension.PointHamiltonian

/-!
# Moving a two-parameter family of points by Hamiltonian diffeotopies with a parameter

Let `σ` be a symplectic form on a Hausdorff, σ-compact, boundaryless manifold `M`, and
`H : [0, 1] × [0, 1] → M` smooth. Suppose that `H (t, 0) = e (t, x₀)`, where the `e (t, ·)` form a
smooth family of embeddings of an open subset of a vector space of the dimension of `M`. This file
gives compactly supported Hamiltonian diffeotopies `Φ_t` of `M`, all supported in one compact
subset of a given open neighbourhood `W` of the image of `H`, jointly smooth in `(t, s, y)`, such
that `Φ_t (s, H (t, 0)) = H (t, s)`, and `Φ_t` is the identity whenever `H (t, ·)` is constant
(`SymplecticGeometry.exists_isCompactlySupportedHamiltonian_param_apply_mk_zero_eq`). This is the
pointwise counterpart of `SymplecticGeometry.exists_isCompactlySupportedHamiltonian_param_apply_eq`,
whose Steps 3 and 4 the proof repeats:

1. A smooth family of compactly supported functions `F (t, ·, ·)`, zero where `H (t, ·)` is
   constant, whose differential at `H (t, s)` is `σ (∂ₛ H (t, s), ·)`
   (`SymplecticGeometry.exists_contMDiff_mfderiv_eq_velocity_contraction`).
2. The diffeotopies `Φ_t` generated by `F (t, ·, ·)`
   (`TauCeti.Diffeotopy.exists_isGeneratedBy_param_unitInterval`).
3. By nondegeneracy, the velocity of `Φ_t` at `H (t, s)` is `∂ₛ H (t, s)`, so the curve
   `s ↦ H (t, s)` is a trajectory of `Φ_t` (`TauCeti.Diffeotopy.apply_eq_of_mfderiv_eq_velocity`).

For a family `e` of symplectic balls centred at the points `H (t, 0)`, the hypotheses on `e` come
from `SymplecticGeometry.IsSymplecticBallFamily.exists_smoothIsotopy`. The result then moves the
centre of a family of balls along a null-homotopy of the loop of centres, a step of the proof of
Lemma 7.1.25 of [McDuffSalamon2017].

## Main results

* `SymplecticGeometry.exists_isCompactlySupportedHamiltonian_param_apply_mk_zero_eq`: Hamiltonian
  diffeotopies, with a parameter `t`, that move `H (t, 0)` along `s ↦ H (t, s)`.

## References

* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017],
  Theorem 3.3.1 and Lemma 7.1.25.
-/

public section

noncomputable section

open Manifold TopologicalSpace
open scoped ContDiff Manifold

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {σ : TauCeti.SmoothTwoForm I M} {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']

namespace SymplecticGeometry

open TauCeti

/-- **Hamiltonian diffeotopies with a parameter moving a two-parameter family of points.** Let `σ`
be a symplectic form on a Hausdorff, σ-compact, boundaryless manifold `M` modelled on `E`, and let
`H : [0, 1] × [0, 1] → M` be smooth. Let `P` be an open subset of a real normed space `E'` with
`dim E' = dim E`, and `e : [0, 1] × P → M` smooth with every slice `e (t, ·)` a smooth embedding
and `e (t, x₀) = H (t, 0)`. Let `W ⊆ M` be open and contain every `H (t, s)`. Then there are
compactly supported Hamiltonian diffeotopies `Φ_t` of `M`, `t ∈ [0, 1]`, and a compact `K ⊆ W`
such that
* `(t, s, y) ↦ Φ_t (s, y)` is smooth;
* `Φ_t (s, y) = y` for every `t` and `s` and every `y ∉ K`;
* `Φ_t (s, H (t, 0)) = H (t, s)` for every `t` and `s`;
* `Φ_t` is the identity at every time whenever `H (t, s) = H (t, 0)` for all `s`. -/
theorem exists_isCompactlySupportedHamiltonian_param_apply_mk_zero_eq [FiniteDimensional ℝ E]
    [I.Boundaryless] [T2Space M] [SigmaCompactSpace M] (hσ : σ.IsSymplectic)
    (hd : Module.finrank ℝ E' = Module.finrank ℝ E)
    {H : unitInterval × unitInterval → M} (hH : ContMDiff ((𝓡∂ 1).prod (𝓡∂ 1)) I ∞ H)
    {P : Opens E'} {e : unitInterval × P → M} (he : ContMDiff ((𝓡∂ 1).prod 𝓘(ℝ, E')) I ∞ e)
    (hemb : ∀ t, IsSmoothEmbedding 𝓘(ℝ, E') I ∞ fun x ↦ e (t, x)) {x₀ : P}
    (heH : ∀ t, e (t, x₀) = H (t, 0))
    {W : Set M} (hW : IsOpen W) (hHW : ∀ t s, H (t, s) ∈ W) :
    ∃ (Φ : unitInterval → Diffeotopy I ∞ M) (K : Set M), IsCompact K ∧ K ⊆ W ∧
      (∀ t, (Φ t).IsCompactlySupportedHamiltonian σ) ∧
      ContMDiff (((𝓡∂ 1).prod (𝓡∂ 1)).prod I) I ∞
        (fun p : (unitInterval × unitInterval) × M ↦ Φ p.1.1 (p.1.2, p.2)) ∧
      (∀ t s, ∀ y ∉ K, Φ t (s, y) = y) ∧
      (∀ t s, Φ t (s, H (t, 0)) = H (t, s)) ∧
      ∀ t, (∀ s, H (t, s) = H (t, 0)) → ∀ s y, Φ t (s, y) = y := by
  -- Step 1: functions whose differentials at `H (t, s)` are `σ (∂ₛ H (t, s), ·)`.
  obtain ⟨F, K, hF, hK, hKW, hFK, hF0, hdF⟩ :=
    exists_contMDiff_mfderiv_eq_velocity_contraction (σ := σ) hd hH he hemb heH hW hHW
  -- Step 2: the diffeotopies generated by the slices of `F`.
  obtain ⟨Φ, hgen, hsmooth, hfix, hid⟩ :=
    Diffeotopy.exists_isGeneratedBy_param_unitInterval hσ hF hK hFK
  refine ⟨Φ, K, hK, hKW, fun t ↦ (hgen t).isCompactlySupportedHamiltonian hσ.isClosed hK
      fun p hp ↦ hFK t p.1 p.2 hp, hsmooth, hfix, fun t s ↦ ?_,
    fun t ht ↦ hid t fun y s ↦ hF0 t ht y s⟩
  -- Step 3: the curve `s ↦ H (t, s)` solves the equation of `Φ t`.
  refine (Φ t).apply_eq_of_mfderiv_eq_velocity (γ := fun u ↦ H (t, u))
    ((hH.comp (contMDiff_const.prodMk contMDiff_id)).mdifferentiable (by simp)) (fun u ↦ ?_) s
  refine (hσ.isNondegenerate.isInvertible_flat _).injective (ContinuousLinearMap.ext fun v ↦ ?_)
  rw [SmoothTwoForm.flat_apply, SmoothTwoForm.flat_apply, SmoothBundleForm.eval₂_apply,
    SmoothTwoForm.isHamiltonianVectorField_iff.1 ((hgen t).isHamiltonianVectorField u),
    mvfderiv_apply_eq_mfderiv_apply]
  exact hdF t u v

end SymplecticGeometry

end
