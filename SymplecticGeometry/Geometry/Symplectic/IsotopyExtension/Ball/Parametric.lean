module

public import SymplecticGeometry.Geometry.Symplectic.Flux.CompactSupport
public import SymplecticGeometry.Geometry.Symplectic.IsotopyExtension.Ball.Basic
import SymplecticGeometry.Geometry.Manifold.SmoothIsotopy.Transport
import SymplecticGeometry.Geometry.Symplectic.Flux.Parametric
import SymplecticGeometry.Geometry.Symplectic.IsotopyExtension.Ball.VelocityPrimitive
import SymplecticGeometry.Geometry.Symplectic.IsotopyExtension.Flow

/-!
# Hamiltonian extension of a family of ball isotopies with a parameter

Let `σ` be a symplectic form on a Hausdorff, σ-compact, boundaryless manifold `M` of dimension
`2n`, and `G : [0, 1] × [0, 1] × StdSpace (Fin n) → M` a map, jointly smooth on
`[0, 1]² × B°(ρ)`, such that for every `t` the maps `G (t, s, ·)`, `s ∈ [0, 1]`, form a smooth
family of symplectic embeddings of the closed ball `B(ρ)`
(`SymplecticGeometry.IsSymplecticBallFamily`). For `ρ' < ρ` and an open `W ⊆ M` containing the
images of `B(ρ')`, there are compactly supported Hamiltonian diffeotopies `Φ_t` of `M`, all
supported in one compact `K ⊆ W`, such that `(t, s, y) ↦ Φ_t (s, y)` is jointly smooth,
`Φ_t (s, G (t, 0, z)) = G (t, s, z)` on `B(ρ')`, and `Φ_t` is the identity at every `t` where
`G (t, ·, ·)` does not move
(`SymplecticGeometry.exists_isCompactlySupportedHamiltonian_param_apply_eq`). This is the
one-path theorem `SymplecticGeometry.IsSymplecticBallFamily.exists_hasHamiltonian_forall_apply_eq`
with a smooth parameter `t`, and its proof follows that one, with each step carried out for all
`t` at once:

1. Primitives `h ((t, s), ·)` of the velocity forms on a ball `P = B°(ρ'')`, `ρ' < ρ'' < ρ`,
   jointly smooth and zero where `G` stands still
   (`SymplecticGeometry.IsSymplecticBallFamily.exists_contMDiff_velocityForm_eq_mextDeriv`).
2. A function `F (t, y, s)` on `[0, 1] × M × [0, 1]`, vanishing off a compact `K ⊆ W`, with
   `F (t, G (t, s, ·), s) = h ((t, s), ·)` near `B(ρ')`, and zero where `h` is
   (`ContMDiff.exists_contMDiff_unitInterval_family_comp_eventuallyEq`).
3. The diffeotopies `Φ_t` generated by `F (t, ·, ·)`, jointly smooth in `t`
   (`TauCeti.Diffeotopy.exists_isGeneratedBy_param_unitInterval`).
4. Along `s ↦ G (t, s, z)` the velocity of `Φ_t` is that of the path, as in
   `TauCeti.SmoothIsotopy.exists_diffeotopy_interior_velocity_eq_forall_apply_eq`
   (`TauCeti.SmoothIsotopy.apply_eq_mfderiv_of_interior_eq`), and uniqueness of solutions gives
   `Φ_t (s, G (t, 0, z)) = G (t, s, z)`.

## Main results

* `SymplecticGeometry.exists_isCompactlySupportedHamiltonian_param_apply_eq`: the Hamiltonian
  extension of a family of ball isotopies with a parameter.

## References

* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017],
  Theorem 3.3.1 and Proposition 7.1.22.
-/

public section

noncomputable section

open Set Function Metric Filter
open scoped ContDiff Manifold Topology

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {σ : TauCeti.SmoothTwoForm I M}

namespace SymplecticGeometry

open TauCeti

variable {n : ℕ}

/-- **Hamiltonian extension of a family of ball isotopies with a parameter.** Let `σ` be a
symplectic form on a Hausdorff, σ-compact, boundaryless manifold `M` of dimension `2n`, let
`ρ' < ρ` with `0 < ρ`, and let `G : [0, 1] × [0, 1] × StdSpace (Fin n) → M` be jointly smooth on
`[0, 1]² × B°(ρ)`, such that for every `t` the maps `G (t, s, ·)`, `s ∈ [0, 1]`, form a smooth
family of symplectic embeddings of `B(ρ)`. Let `W ⊆ M` be open and contain `G (t, s, z)` for all
`t`, `s` and `z ∈ B(ρ')`. Then there are compactly supported Hamiltonian diffeotopies `Φ_t` of
`M`, `t ∈ [0, 1]`, and a compact `K ⊆ W` such that
* `(t, s, y) ↦ Φ_t (s, y)` is smooth;
* `Φ_t (s, y) = y` for every `t` and `s` and every `y ∉ K`;
* `Φ_t (s, G (t, 0, z)) = G (t, s, z)` for every `t` and `s` and every `z ∈ B(ρ')`;
* `Φ_t` is the identity at every time whenever `G (t, s, z) = G (t, 0, z)` for all `s` and all
  `z` in the open ball `B°(ρ)`. -/
theorem exists_isCompactlySupportedHamiltonian_param_apply_eq [FiniteDimensional ℝ E]
    [I.Boundaryless] [T2Space M] [SigmaCompactSpace M] (hσ : σ.IsSymplectic)
    (hdim : Module.finrank ℝ E = 2 * n) {ρ ρ' : ℝ} (hρ : 0 < ρ) (hρ' : ρ' < ρ)
    {G : unitInterval × unitInterval × StdSpace (Fin n) → M}
    (hG : ContMDiffOn ((𝓡∂ 1).prod ((𝓡∂ 1).prod 𝓘(ℝ, StdSpace (Fin n)))) I ∞ G
      (univ ×ˢ (univ ×ˢ ball 0 ρ)))
    (he : ∀ t, IsSymplecticBallFamily σ ρ fun p ↦ G (t, p.1, p.2))
    {W : Set M} (hW : IsOpen W) (hGW : ∀ t s, ∀ z ∈ closedBall 0 ρ', G (t, s, z) ∈ W) :
    ∃ (Φ : unitInterval → Diffeotopy I ∞ M) (K : Set M), IsCompact K ∧ K ⊆ W ∧
      (∀ t, (Φ t).IsCompactlySupportedHamiltonian σ) ∧
      ContMDiff (((𝓡∂ 1).prod (𝓡∂ 1)).prod I) I ∞
        (fun p : (unitInterval × unitInterval) × M ↦ Φ p.1.1 (p.1.2, p.2)) ∧
      (∀ t s, ∀ y ∉ K, Φ t (s, y) = y) ∧
      (∀ t s, ∀ z ∈ closedBall 0 ρ', Φ t (s, G (t, 0, z)) = G (t, s, z)) ∧
      ∀ t, (∀ s, ∀ z ∈ ball 0 ρ, G (t, s, z) = G (t, 0, z)) → ∀ s y, Φ t (s, y) = y := by
  obtain ⟨ρ'', hρ'ρ'', hρ''ρ⟩ := exists_between (max_lt hρ' hρ)
  have hρ'' : 0 < ρ'' := (le_max_right _ _).trans_lt hρ'ρ''
  -- Step 1: primitives `h` of the velocity forms on the open ball `P = B°(ρ'')`.
  let P : TopologicalSpace.Opens (StdSpace (Fin n)) := ⟨ball 0 ρ'', isOpen_ball⟩
  have hPρ : (P : Set (StdSpace (Fin n))) ⊆ ball 0 ρ := ball_subset_ball hρ''ρ.le
  obtain ⟨f₀, f₁, k, h, hk, hh, hdh, hzero⟩ :=
    IsSymplecticBallFamily.exists_contMDiff_velocityForm_eq_mextDeriv hσ.isClosed hρ
      (P := P) (convex_ball 0 ρ'') ⟨0, mem_ball_self hρ''⟩ (hPρ.trans ball_subset_closedBall)
      (hG.mono (prod_mono subset_rfl (prod_mono subset_rfl hPρ))) he
  -- Step 2: a function `F` on `[0, 1] × M × [0, 1]` that reads `h` along `G`.
  have hkk : ContMDiff ((𝓡∂ 1).prod ((𝓡∂ 1).prod 𝓘(ℝ, StdSpace (Fin n)))) I ∞
      (fun p : unitInterval × unitInterval × P ↦ G (p.1, p.2.1, p.2.2)) :=
    hG.comp_contMDiff (contMDiff_fst.prodMk (contMDiff_snd.fst.prodMk
      (contMDiff_subtypeVal.comp contMDiff_snd.snd)))
      fun q ↦ ⟨mem_univ _, mem_univ _, hPρ q.2.2.property⟩
  have hemb (a s : unitInterval) :
      Manifold.IsSmoothEmbedding 𝓘(ℝ, StdSpace (Fin n)) I ∞ fun x : P ↦ G (a, s, x) := by
    simpa only [SmoothIsotopy.toContMDiffMap_apply, hk] using (k a).isSmoothEmbedding s
  have hd : Module.finrank ℝ (StdSpace (Fin n)) = Module.finrank ℝ E := by
    simp [hdim, two_mul]
  have hA : IsCompact (Subtype.val ⁻¹' closedBall 0 ρ' : Set P) :=
    Topology.IsInducing.subtypeVal.isCompact_preimage' (isCompact_closedBall 0 ρ')
      (by rw [Subtype.range_coe]; exact closedBall_subset_ball ((le_max_left _ _).trans_lt hρ'ρ''))
  obtain ⟨F, K, hF, hK, hKW, hFK, hFk, hF0⟩ :=
    hkk.exists_contMDiff_unitInterval_family_comp_eventuallyEq hd hA hemb
      (h := fun p ↦ h ((p.1, p.2.1), p.2.2))
      (hh.comp ((contMDiff_fst.prodMk contMDiff_snd.fst).prodMk contMDiff_snd.snd)) hW
      fun a s x hx ↦ hGW a s x hx
  -- Step 3: the diffeotopies generated by the slices of `F`.
  obtain ⟨Φ, hgen, hsmooth, hfix, hid⟩ :=
    Diffeotopy.exists_isGeneratedBy_param_unitInterval hσ hF hK hFK
  refine ⟨Φ, K, hK, hKW, fun t ↦ (hgen t).isCompactlySupportedHamiltonian hσ.isClosed hK
      fun p hp ↦ hFK t p.1 p.2 hp, hsmooth, hfix, fun t s z hz ↦ ?_,
    fun t ht ↦ hid t fun y s ↦ hF0 t (fun s x ↦ hzero t (fun s x hx ↦ ht s x (hPρ hx)) s x) y s⟩
  -- Step 4: along `s ↦ G (t, s, z)`, the velocity of `Φ t` is that of the path.
  have hzP : z ∈ (P : Set (StdSpace (Fin n))) :=
    closedBall_subset_ball ((le_max_left _ _).trans_lt hρ'ρ'') hz
  let x : P := ⟨z, hzP⟩
  rw [← hk t (0, x), ← hk t (s, x)]
  refine (Φ t).apply_eq_of_mfderiv_eq_velocity (γ := fun u ↦ k t (u, x))
    (((k t).contMDiff.comp (contMDiff_id.prodMk contMDiff_const)).mdifferentiable (by simp))
    (fun u ↦ (SmoothIsotopy.apply_eq_mfderiv_of_interior_eq hσ.isNondegenerate (k t) hd
      (β := 0) (h := fun p ↦ h ((t, p.1), p.2))
      (by rw [hdh t u, map_zero, ZeroMemClass.coe_zero, mpullback_zero, zero_add])
      (hgen t).contMDiff (by simpa only [hk] using hFk t u x hz)
      (by rw [map_zero, ZeroMemClass.coe_zero, zero_add]
          exact SmoothTwoForm.isHamiltonianVectorField_iff_interior_eq.1
            ((hgen t).isHamiltonianVectorField u))).symm) s

end SymplecticGeometry

end
