module

public import SymplecticGeometry.Geometry.Symplectic.Flux.Hamiltonian
import SymplecticGeometry.Geometry.Diffeomorphism.Diffeotopy.Basic

/-!
# Compactly supported Hamiltonian diffeomorphisms

Let `σ` be a two-form on a manifold `M` and `φ_t`, `t ∈ [0, 1]`, a smooth diffeotopy of `M`. In
McDuff–Salamon, §3.1, `φ_t` is a compactly supported Hamiltonian isotopy when every `φ_t`
preserves `σ` and `φ_t` is generated by a time-dependent Hamiltonian `H_t` that vanishes, for
every `t`, outside one compact set `K ⊆ M`. Tau Ceti reads Hamiltonians along the motion, as
`F (x, t) = H_t (φ_t x)` (`TauCeti.Diffeotopy.HasHamiltonian`), so the condition becomes
`F (x, t) = 0` whenever `φ_t x ∉ K`
(`TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian`); read on `M` with
`TauCeti.Diffeotopy.IsGeneratedBy`, it is the original condition
(`TauCeti.Diffeotopy.isCompactlySupportedHamiltonian_iff_isGeneratedBy`). The final maps of
these diffeotopies form the group `Ham_c(M, σ)`
(`TauCeti.SmoothForm.compactlySupportedHamiltonianGroup`).

## Main definitions

* `TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian σ Φ`: `Φ` is a Hamiltonian diffeotopy of
  `σ` with a Hamiltonian that vanishes off a compact set.
* `TauCeti.SmoothForm.compactlySupportedHamiltonianGroup σ`: the group `Ham_c(M, σ)` of final
  maps of such diffeotopies.

## Main results

* `TauCeti.Diffeotopy.isCompactlySupportedHamiltonian_iff_isGeneratedBy`: the predicate holds
  exactly when every `φ_t` preserves `σ` and `φ_t` is generated by a function on `M × [0, 1]`
  that vanishes off a compact subset of `M`.
* `TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian.trans`,
  `TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian.symm`,
  `TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian.transDiffeomorph`: composites, inverses and
  conjugates by diffeomorphisms preserving `σ` of compactly supported Hamiltonian diffeotopies are
  compactly supported Hamiltonian diffeotopies.
* `TauCeti.SmoothForm.compactlySupportedHamiltonianGroup_le_hamiltonianGroup`: `Ham_c(M, σ)` lies
  in `Ham(M, σ)`.
* `TauCeti.SmoothForm.normal_compactlySupportedHamiltonianGroup_subgroupOf_diffeomorphStabilizer`:
  `Ham_c(M, σ)` is normal in the group of diffeomorphisms preserving `σ`.
* `TauCeti.SmoothForm.compactlySupportedHamiltonianGroup_eq_hamiltonianGroup`: on a compact
  manifold, `Ham_c(M, σ) = Ham(M, σ)`.

## Implementation notes

The predicate asks for vanishing off a compact set rather than for a compact support of `H_t`, so
that `M` need not be Hausdorff; on a Hausdorff `M` the two agree. It is not the condition that the
diffeotopy fixes every point off a compact set: adding to a Hamiltonian a function of `t` alone,
on each connected component, gives another Hamiltonian of the same diffeotopy
(`TauCeti.Diffeotopy.IsGeneratedBy.exists_sub_eq`), and a diffeotopy can be compactly supported
without having a Hamiltonian that vanishes off a compact set.

The subgroup and its API follow Tau Ceti's `TauCeti.SmoothForm.hamiltonianGroup`,
`TauCeti.SmoothForm.mul_mul_inv_mem_hamiltonianGroup` and
`TauCeti.SmoothForm.normal_hamiltonianGroup_subgroupOf_diffeomorphStabilizer`, and the rules for
the predicate add compact sets to Tau Ceti's `TauCeti.Diffeotopy.IsHamiltonian.trans`,
`TauCeti.Diffeotopy.IsHamiltonian.symm` and `TauCeti.Diffeotopy.IsHamiltonian.transDiffeomorph`.

## References

* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017], §3.1,
  Definition 3.1.13 and Exercise 3.1.14.
-/

public noncomputable section

open Set
open scoped Manifold ContDiff

namespace TauCeti

namespace Diffeotopy

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {J : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold J ∞ M] {σ : SmoothForm J M ℝ 2} {Φ Ψ : Diffeotopy J ∞ M}

/-- A diffeotopy `φ_t` is a **compactly supported Hamiltonian diffeotopy** of the two-form `σ`
when every `φ_t` preserves `σ` and `φ_t` has a Hamiltonian `F`, read along the motion, with
`F (x, t) = 0` whenever `φ_t x` lies outside a fixed compact set `K`. Equivalently, `φ_t` is
generated by a time-dependent Hamiltonian `H_t = F_t ∘ φ_t⁻¹` that vanishes off `K` for every
`t` (`isCompactlySupportedHamiltonian_iff_isGeneratedBy`). -/
def IsCompactlySupportedHamiltonian (σ : SmoothForm J M ℝ 2) (Φ : Diffeotopy J ∞ M) : Prop :=
  (∀ t, Φ.timeSlice t ∈ SmoothForm.diffeomorphStabilizer σ) ∧
    ∃ F, Φ.HasHamiltonian σ F ∧ ∃ K : Set M, IsCompact K ∧ ∀ p, Φ.cylinderMap p ∉ K → F p = 0

/-- Unfolding `TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian`. -/
theorem isCompactlySupportedHamiltonian_iff : Φ.IsCompactlySupportedHamiltonian σ ↔
    (∀ t, Φ.timeSlice t ∈ SmoothForm.diffeomorphStabilizer σ) ∧
      ∃ F, Φ.HasHamiltonian σ F ∧ ∃ K : Set M, IsCompact K ∧
        ∀ p, Φ.cylinderMap p ∉ K → F p = 0 :=
  Iff.rfl

/-- **The reading on `M`.** A diffeotopy `φ_t` is a compactly supported Hamiltonian diffeotopy of
`σ` exactly when every `φ_t` preserves `σ` and `φ_t` is generated by a function `G` on
`M × [0, 1]` (`TauCeti.Diffeotopy.IsGeneratedBy`) with `G (x, t) = 0` whenever `x` lies outside
a fixed compact set `K`. -/
theorem isCompactlySupportedHamiltonian_iff_isGeneratedBy : Φ.IsCompactlySupportedHamiltonian σ ↔
    (∀ t, Φ.timeSlice t ∈ SmoothForm.diffeomorphStabilizer σ) ∧
      ∃ G, Φ.IsGeneratedBy σ G ∧ ∃ K : Set M, IsCompact K ∧
        ∀ p : M × unitInterval, p.1 ∉ K → G p = 0 := by
  refine and_congr_right fun _ ↦ ⟨fun ⟨F, hF, K, hK, hFK⟩ ↦ ⟨fun p ↦ F (Φ.symm (p.2, p.1), p.2),
    hasHamiltonian_comp_iff.1 ?_, K, hK, fun p hp ↦ hFK _ ?_⟩,
    fun ⟨G, hG, K, hK, hGK⟩ ↦ ⟨_, hasHamiltonian_comp_iff.2 hG, K, hK, fun _ hp ↦ hGK _ hp⟩⟩
  · simpa only [cylinderMap_apply, symm_apply_mk_apply] using hF
  · rwa [cylinderMap_apply, apply_mk_symm_apply]

/-- A compactly supported Hamiltonian diffeotopy is Hamiltonian. -/
theorem IsCompactlySupportedHamiltonian.isHamiltonian (hΦ : Φ.IsCompactlySupportedHamiltonian σ) :
    Φ.IsHamiltonian σ :=
  isHamiltonian_iff.2 ⟨hΦ.1, hΦ.2.choose, hΦ.2.choose_spec.1⟩

/-- The constant diffeotopy is a compactly supported Hamiltonian diffeotopy, with the zero
Hamiltonian and the empty compact set. -/
theorem isCompactlySupportedHamiltonian_refl :
    (refl J ∞ M).IsCompactlySupportedHamiltonian σ :=
  ⟨SmoothForm.timeSlice_refl_mem_diffeomorphStabilizer, 0, hasHamiltonian_refl, ∅,
    isCompact_empty, fun _ _ ↦ rfl⟩

/-- The pointwise composite `ψ_t ∘ φ_t` of compactly supported Hamiltonian diffeotopies is a
compactly supported Hamiltonian diffeotopy. If the Hamiltonians of `φ_t` and `ψ_t` vanish off
`K_φ` and `K_ψ`, that of the composite vanishes off `K_ψ ∪ ⋃_t ψ_t (K_φ)`. -/
theorem IsCompactlySupportedHamiltonian.trans (hΦ : Φ.IsCompactlySupportedHamiltonian σ)
    (hΨ : Ψ.IsCompactlySupportedHamiltonian σ) : (Φ.trans Ψ).IsCompactlySupportedHamiltonian σ := by
  obtain ⟨hΦσ, F, hF, KΦ, hKΦ, hFK⟩ := hΦ
  obtain ⟨hΨσ, G, hG, KΨ, hKΨ, hGK⟩ := hΨ
  refine ⟨SmoothForm.timeSlice_trans_mem_diffeomorphStabilizer hΦσ hΨσ, _, hF.trans hG hΨσ,
    KΨ ∪ Ψ.cylinderMap '' (KΦ ×ˢ univ),
    hKΨ.union ((hKΦ.prod isCompact_univ).image Ψ.contMDiff_cylinderMap.continuous),
    fun p hp ↦ ?_⟩
  rw [cylinderMap_trans, Function.comp_apply, mem_union, not_or] at hp
  rw [hGK _ hp.1, hFK p fun h ↦ hp.2 ⟨_, ⟨h, mem_univ _⟩, rfl⟩, add_zero]

/-- The pointwise inverse `φ_t⁻¹` of a compactly supported Hamiltonian diffeotopy is a compactly
supported Hamiltonian diffeotopy. If the Hamiltonian of `φ_t` vanishes off `K`, that of the
inverse vanishes off `⋃_t φ_t⁻¹ (K)`. -/
theorem IsCompactlySupportedHamiltonian.symm (hΦ : Φ.IsCompactlySupportedHamiltonian σ) :
    Φ.symm.IsCompactlySupportedHamiltonian σ := by
  obtain ⟨hΦσ, F, hF, K, hK, hFK⟩ := hΦ
  refine ⟨SmoothForm.timeSlice_symm_mem_diffeomorphStabilizer hΦσ, _, hF.symm hΦσ,
    Φ.symm.cylinderMap '' (K ×ˢ univ),
    (hK.prod isCompact_univ).image Φ.symm.contMDiff_cylinderMap.continuous, fun p hp ↦ ?_⟩
  have hp₁ : p.1 ∉ K := fun h ↦ hp ⟨p, ⟨h, mem_univ _⟩, rfl⟩
  rw [hFK _ (by rwa [cylinderMap_apply, cylinderMap_apply, apply_mk_symm_apply]), neg_zero]

/-- The conjugate `f ∘ φ_t ∘ f⁻¹` of a compactly supported Hamiltonian diffeotopy `φ_t` by a
diffeomorphism `f` preserving `σ` is a compactly supported Hamiltonian diffeotopy. If the
Hamiltonian of `φ_t` vanishes off `K`, that of the conjugate vanishes off `f (K)`. -/
theorem IsCompactlySupportedHamiltonian.transDiffeomorph {f : M ≃ₘ⟮J, J⟯ M}
    (hf : f ∈ SmoothForm.diffeomorphStabilizer σ) (hΦ : Φ.IsCompactlySupportedHamiltonian σ) :
    (Φ.transDiffeomorph f).IsCompactlySupportedHamiltonian σ := by
  obtain ⟨hΦσ, F, hF, K, hK, hFK⟩ := hΦ
  refine ⟨SmoothForm.timeSlice_transDiffeomorph_mem_diffeomorphStabilizer hf hΦσ,
    fun p ↦ F (f.symm p.1, p.2),
    HasHamiltonian.transDiffeomorph (F := F) f (by rwa [SmoothForm.mem_diffeomorphStabilizer.1 hf]),
    f '' K, hK.image f.continuous, fun p hp ↦ hFK _ fun h ↦ hp ?_⟩
  rw [cylinderMap_transDiffeomorph]
  exact ⟨_, h, rfl⟩

/-- On a compact manifold every Hamiltonian diffeotopy is compactly supported, with the compact
set `M`. -/
theorem isCompactlySupportedHamiltonian_of_compactSpace [CompactSpace M]
    (hΦ : Φ.IsHamiltonian σ) : Φ.IsCompactlySupportedHamiltonian σ := by
  obtain ⟨hΦσ, F, hF⟩ := isHamiltonian_iff.1 hΦ
  exact ⟨hΦσ, F, hF, univ, isCompact_univ, fun _ hp ↦ (hp (mem_univ _)).elim⟩

end Diffeotopy

namespace SmoothForm

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {J : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold J ∞ M] {σ : SmoothForm J M ℝ 2}

variable (σ) in
/-- The group `Ham_c(M, σ)` of **compactly supported Hamiltonian diffeomorphisms** of a two-form
`σ`: the final diffeomorphisms `φ₁` of the compactly supported Hamiltonian diffeotopies `φ_t` of
`σ` (`TauCeti.Diffeotopy.IsCompactlySupportedHamiltonian`). -/
def compactlySupportedHamiltonianGroup : Subgroup (M ≃ₘ⟮J, J⟯ M) where
  carrier := {φ | ∃ Φ : Diffeotopy J ∞ M, Φ.IsCompactlySupportedHamiltonian σ ∧ Φ.final = φ}
  one_mem' := ⟨Diffeotopy.refl J ∞ M, Diffeotopy.isCompactlySupportedHamiltonian_refl,
    Diffeotopy.final_refl⟩
  mul_mem' := by
    rintro _ _ ⟨Φ, hΦ, rfl⟩ ⟨Ψ, hΨ, rfl⟩
    exact ⟨Ψ.trans Φ, hΨ.trans hΦ, by rw [Diffeotopy.final_trans, Diffeomorph.mul_def]⟩
  inv_mem' := by
    rintro _ ⟨Φ, hΦ, rfl⟩
    exact ⟨Φ.symm, hΦ.symm, by rw [Diffeotopy.final_symm, Diffeomorph.inv_def]⟩

/-- A diffeomorphism lies in `Ham_c(M, σ)` exactly when it is the final diffeomorphism of a
compactly supported Hamiltonian diffeotopy. -/
theorem mem_compactlySupportedHamiltonianGroup {φ : M ≃ₘ⟮J, J⟯ M} :
    φ ∈ compactlySupportedHamiltonianGroup σ ↔
      ∃ Φ : Diffeotopy J ∞ M, Φ.IsCompactlySupportedHamiltonian σ ∧ Φ.final = φ :=
  Iff.rfl

/-- The final diffeomorphism of a compactly supported Hamiltonian diffeotopy lies in
`Ham_c(M, σ)`. -/
theorem final_mem_compactlySupportedHamiltonianGroup {Φ : Diffeotopy J ∞ M}
    (hΦ : Φ.IsCompactlySupportedHamiltonian σ) :
    Φ.final ∈ compactlySupportedHamiltonianGroup σ :=
  ⟨Φ, hΦ, rfl⟩

/-- Compactly supported Hamiltonian diffeomorphisms are Hamiltonian: `Ham_c(M, σ) ≤ Ham(M, σ)`. -/
theorem compactlySupportedHamiltonianGroup_le_hamiltonianGroup :
    compactlySupportedHamiltonianGroup σ ≤ hamiltonianGroup σ := by
  rintro _ ⟨Φ, hΦ, rfl⟩
  exact final_mem_hamiltonianGroup hΦ.isHamiltonian

/-- Conjugating a compactly supported Hamiltonian diffeomorphism by a diffeomorphism `f`
preserving `σ` gives a compactly supported Hamiltonian diffeomorphism. -/
theorem mul_mul_inv_mem_compactlySupportedHamiltonianGroup {f φ : M ≃ₘ⟮J, J⟯ M}
    (hf : f ∈ diffeomorphStabilizer σ) (hφ : φ ∈ compactlySupportedHamiltonianGroup σ) :
    f * φ * f⁻¹ ∈ compactlySupportedHamiltonianGroup σ := by
  obtain ⟨Φ, hΦ, rfl⟩ := hφ
  exact ⟨Φ.transDiffeomorph f, hΦ.transDiffeomorph hf,
    Diffeotopy.final_transDiffeomorph_eq_mul_mul_inv Φ f⟩

/-- `Ham_c(M, σ)` is a normal subgroup of the group of diffeomorphisms preserving `σ`. -/
instance normal_compactlySupportedHamiltonianGroup_subgroupOf_diffeomorphStabilizer :
    ((compactlySupportedHamiltonianGroup σ).subgroupOf (diffeomorphStabilizer σ)).Normal :=
  (Subgroup.normal_subgroupOf_iff (compactlySupportedHamiltonianGroup_le_hamiltonianGroup.trans
    (hamiltonianGroup_le_isotopyStabilizer.trans isotopyStabilizer_le_diffeomorphStabilizer))).2
    fun _ _ hφ hf ↦ mul_mul_inv_mem_compactlySupportedHamiltonianGroup hf hφ

/-- On a compact manifold, every Hamiltonian diffeomorphism is compactly supported:
`Ham_c(M, σ) = Ham(M, σ)`. -/
theorem compactlySupportedHamiltonianGroup_eq_hamiltonianGroup [CompactSpace M] :
    compactlySupportedHamiltonianGroup σ = hamiltonianGroup σ := by
  refine le_antisymm compactlySupportedHamiltonianGroup_le_hamiltonianGroup fun φ hφ ↦ ?_
  obtain ⟨Φ, hΦ, rfl⟩ := mem_hamiltonianGroup.1 hφ
  exact final_mem_compactlySupportedHamiltonianGroup
    (Diffeotopy.isCompactlySupportedHamiltonian_of_compactSpace hΦ)

end SmoothForm

end TauCeti

end
