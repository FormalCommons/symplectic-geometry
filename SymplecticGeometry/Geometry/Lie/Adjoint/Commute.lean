module

public import TauCeti.Geometry.Lie.Adjoint.Basic
import TauCeti.Geometry.Lie.Adjoint.Exponential.Formula
import TauCeti.Geometry.Lie.Exponential.Generation
import TauCeti.Geometry.Lie.Interior
import SymplecticGeometry.Geometry.Lie.GroupLieAlgebra.Model

/-!
# Linear maps commuting with the adjoint action

On a connected finite-dimensional real Lie group `G`, a linear map `J` of the Lie algebra that
commutes with every `ad x` (`J ⁅x, y⁆ = ⁅x, J y⁆`) also commutes with every `Ad g`.

The elements `g` with `J ∘ Ad g = Ad g ∘ J` form a subgroup. It contains every `exp x`, since
`Ad (exp x)` is the operator exponential of `ad x` (Tau Ceti's
`TauCeti.Lie.tangentAd_mulInvariantExp_apply`) and `J` commutes with `ad x`, and a connected Lie
group is generated by the image of its exponential (Tau Ceti's
`TauCeti.closure_range_lieExp_eq_top`).

## Main results

* `TauCeti.Lie.map_tangentAd_apply_of_map_lie`: `J (Ad g y) = Ad g (J y)`.
-/

public section

open Manifold
open scoped Manifold ContDiff

namespace TauCeti.Lie

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G] [LieGroup I ∞ G]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField
  ContMDiffMul.boundarylessManifold

/-- On a preconnected Lie group, a linear map of the Lie algebra that commutes with every `ad x`
commutes with every `Ad g`: `J (Ad g y) = Ad g (J y)`. -/
theorem map_tangentAd_apply_of_map_lie [PreconnectedSpace G]
    (J : GroupLieAlgebra I G →ₗ[ℝ] GroupLieAlgebra I G)
    (hJ : ∀ x y : GroupLieAlgebra I G, J ⁅x, y⁆ = ⁅x, J y⁆) (g : G) (y : GroupLieAlgebra I G) :
    J (tangentAd (I := I) g y) = tangentAd (I := I) g (J y) := by
  let _ : T2Space G := I.t2Space_of_lieGroup ∞
  let _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  let S : Subgroup G :=
    { carrier := {g | ∀ y, J (tangentAd (I := I) g y) = tangentAd (I := I) g (J y)}
      mul_mem' := fun {a b} ha hb y ↦ by
        rw [Set.mem_ofPred_eq] at ha hb
        rw [tangentAd_mul, LieEquiv.trans_apply, LieEquiv.trans_apply, ha, hb]
      one_mem' := fun y ↦ by simp
      inv_mem' := fun {a} ha y ↦ by
        rw [Set.mem_ofPred_eq] at ha
        rw [tangentAd_inv, eq_comm, LieEquiv.symm_apply_eq, ← ha, LieEquiv.apply_symm_apply] }
  have hexp : Set.range (lieExp (I := I) (G := G)) ⊆ S := by
    rintro _ ⟨X, rfl⟩ y
    rw [lieExp_eq_mulInvariantExp]
    set x := leftInvariantDerivationEquivGroupLieAlgebra (I := I) (G := G)
      BoundarylessManifold.isInteriorPoint X
    -- `Ad (exp x)` is the operator exponential of `ad x`, as an operator on the model space `E`.
    let A := (Module.End.toContinuousLinearMap E)
      ((groupLieAlgebraEquivModelVectorSpace (I := I) (G := G)).conj
        (LieAlgebra.ad ℝ (GroupLieAlgebra I G) x))
    let J' : E →L[ℝ] E := LinearMap.toContinuousLinearMap J
    -- `A` and `J'` act on `E` as `ad x` and `J` act on `GroupLieAlgebra I G`, so `hJ` says
    -- that they commute.
    have hA := toContinuousLinearMap_conj_groupLieAlgebraEquivModelVectorSpace_ad_apply (E := E) x
    have hJ' := LinearMap.coe_toContinuousLinearMap' J
    have hc : Commute J' A := ContinuousLinearMap.ext fun z ↦
      (mul_apply_eq_comp J' A z).trans <| (congrFun hJ' (A z)).trans <|
      (congrArg J (hA z)).trans <| (hJ x z).trans <| (hA (J z)).symm.trans <|
      (congrArg A (congrFun hJ' z).symm).trans (mul_apply_eq_comp A J' z).symm
    have h (z : E) : J' (NormedSpace.exp A z) = NormedSpace.exp A (J' z) := by
      rw [← mul_apply_eq_comp, ← mul_apply_eq_comp, hc.exp_right.eq]
    have h₁ := tangentAd_mulInvariantExp_apply (I := I) (G := G) x y
    have h₂ := tangentAd_mulInvariantExp_apply (I := I) (G := G) x (J y)
    dsimp only at h₁ h₂
    rw [h₁, h₂]
    -- `J'` is `J` read on `E`; `LinearMap.coe_toContinuousLinearMap'` does not rewrite here, since
    -- its two sides are typed in `E` and the goal in `GroupLieAlgebra I G`.
    exact h y
  have hS : S = ⊤ := top_unique <| closure_range_lieExp_eq_top (I := I) (G := G) ▸
    (Subgroup.closure_le S).2 hexp
  exact (hS ▸ Subgroup.mem_top g : g ∈ S) y

end TauCeti.Lie

end
