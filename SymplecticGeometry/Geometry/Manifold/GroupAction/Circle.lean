module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import SymplecticGeometry.Geometry.Lie.Exponential.Circle
public import TauCeti.Geometry.Lie.FundamentalVectorField.Right
public import TauCeti.Geometry.Manifold.GroupAction.InvariantForm

/-!
# Circle actions with period one

A circle action is an action of Mathlib's `Circle`. Its parameters are taken with period one: the
parameter `t : ℝ` acts as `Circle.exp (2 * π * t)`. This file supplies the generator of the Lie
algebra of `Circle` for this normalization, `ξ₁ = 2π • circleLieGenerator`, and the two facts about
its fundamental vector field `X_{ξ₁}` that later work on circle actions uses.

* The flow of `X_{ξ₁}` is `(t, x) ↦ Circle.exp (2 * π * t) • x`, so it has period one. This is Tau
  Ceti's `TauCeti.globalFlow_fundamentalVectorField` for this generator.
* A point is fixed by the whole circle exactly when `X_{ξ₁}` vanishes there. One direction is Tau
  Ceti's `TauCeti.fundamentalVectorField_eq_zero_of_forall_smul_eq`; the other is Tau Ceti's
  `TauCeti.mulInvariantExp_smul_smul_eq_iff` together with the surjectivity of
  `t ↦ exp (t • ξ₁)`.

## Main definitions

* `SymplecticGeometry.circlePeriodOneGenerator`: the generator `ξ₁` of the Lie algebra of `Circle`
  whose one-parameter subgroup `t ↦ Circle.exp (2 * π * t)` has period one.

## Main results

* `SymplecticGeometry.rightFundamentalVectorField_circlePeriodOneGenerator`: for a right circle
  action, the fundamental vector field of `ξ₁` is `2π` times that of `circleLieGenerator`.
* `SymplecticGeometry.mulInvariantExp_smul_circlePeriodOneGenerator`: the one-parameter subgroup
  of `ξ₁` is `t ↦ Circle.exp (2 * π * t)`.
* `SymplecticGeometry.mulInvariantExp_smul_circlePeriodOneGenerator_surjective`: this one-parameter
  subgroup covers `Circle`, as does `t ↦ Circle.exp (2 * π * t)`
  (`Circle.exp_two_pi_mul_surjective`).
* `SymplecticGeometry.mulInvariantExp_intCast_smul_circlePeriodOneGenerator`: the exponential of
  every integer multiple of `ξ₁` is `1`.
* `SymplecticGeometry.globalFlow_fundamentalVectorField_circlePeriodOneGenerator`: the flow of
  `X_{ξ₁}` at time `t` is the action of `Circle.exp (2 * π * t)`.
* `SymplecticGeometry.periodic_globalFlow_fundamentalVectorField_circlePeriodOneGenerator`: this
  flow has period one.
* `SymplecticGeometry.fixedPoints_circle_eq_setOfPred_fundamentalVectorField_eq_zero`: the fixed
  points of a circle action are the zeros of `X_{ξ₁}`.

## References

* John M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Chapter 20 (one-parameter subgroups and
  infinitesimal generators of actions).
* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017], Section 5.1
  (circle actions and their fundamental vector fields).
-/

public section

noncomputable section

open Manifold TauCeti Real
open scoped Manifold ContDiff

namespace SymplecticGeometry

/-- The generator `ξ₁ = 2π • circleLieGenerator` of the Lie algebra of `Circle` for circle
parameters of period one: its one-parameter subgroup is `t ↦ Circle.exp (2 * π * t)`. -/
def circlePeriodOneGenerator : GroupLieAlgebra (𝓡 1) Circle :=
  (2 * π) • circleLieGenerator

theorem circlePeriodOneGenerator_def :
    circlePeriodOneGenerator = (2 * π) • circleLieGenerator :=
  (rfl)

/-- The period-one generator of the Lie algebra of `Circle` is nonzero. -/
theorem circlePeriodOneGenerator_ne_zero : circlePeriodOneGenerator ≠ 0 := by
  rw [circlePeriodOneGenerator_def]
  exact smul_ne_zero (by positivity) circleLieGenerator_ne_zero

/-- For a right action of `Circle` on `M`, the fundamental vector field of
`circlePeriodOneGenerator` is `2π` times that of `circleLieGenerator`. -/
theorem rightFundamentalVectorField_circlePeriodOneGenerator {E' : Type*}
    [NormedAddCommGroup E'] [NormedSpace ℝ E'] {H' : Type*} [TopologicalSpace H']
    (I' : ModelWithCorners ℝ E' H') {M : Type*} [TopologicalSpace M] [ChartedSpace H' M]
    [MulAction Circleᵐᵒᵖ M] :
    rightFundamentalVectorField (M := M) I' circlePeriodOneGenerator =
      (2 * π) • rightFundamentalVectorField I' circleLieGenerator :=
  by rw [circlePeriodOneGenerator_def, rightFundamentalVectorField_smul]

attribute [local instance] LieGroup.minSmoothness_of_isRCLikeNormedField

/-- The one-parameter subgroup of `Circle` generated by `circlePeriodOneGenerator` is
`t ↦ Circle.exp (2 * π * t)`. -/
@[simp] theorem mulInvariantExp_smul_circlePeriodOneGenerator (t : ℝ) :
    mulInvariantExp (I := 𝓡 1) (G := Circle) (t • circlePeriodOneGenerator) =
      Circle.exp (2 * π * t) := by
  rw [circlePeriodOneGenerator_def, smul_smul, mulInvariantExp_smul_circleLieGenerator, mul_comm]

/-- Every element of `Circle` is `Circle.exp (2 * π * t)` for some real `t`. -/
theorem _root_.Circle.exp_two_pi_mul_surjective :
    Function.Surjective fun t : ℝ ↦ Circle.exp (2 * π * t) := fun g ↦ by
  obtain ⟨θ, rfl⟩ := Circle.exp_surjective g
  exact ⟨θ / (2 * π), congrArg Circle.exp (mul_div_cancel₀ _ (by positivity))⟩

/-- The one-parameter subgroup of `Circle` generated by `circlePeriodOneGenerator` covers
`Circle`. -/
theorem mulInvariantExp_smul_circlePeriodOneGenerator_surjective :
    Function.Surjective
      (fun t : ℝ ↦ mulInvariantExp (I := 𝓡 1) (G := Circle) (t • circlePeriodOneGenerator)) := by
  simpa only [mulInvariantExp_smul_circlePeriodOneGenerator] using
    Circle.exp_two_pi_mul_surjective

/-- The exponential of `circlePeriodOneGenerator` is the identity of `Circle`. -/
@[simp] theorem mulInvariantExp_circlePeriodOneGenerator :
    mulInvariantExp (I := 𝓡 1) (G := Circle) circlePeriodOneGenerator = 1 := by
  simpa using mulInvariantExp_smul_circlePeriodOneGenerator 1

/-- The exponential of an integer multiple of `circlePeriodOneGenerator` is the identity of
`Circle`. -/
theorem mulInvariantExp_intCast_smul_circlePeriodOneGenerator (n : ℤ) :
    mulInvariantExp (I := 𝓡 1) (G := Circle) ((n : ℝ) • circlePeriodOneGenerator) = 1 := by
  rw [mulInvariantExp_smul_circlePeriodOneGenerator, Circle.exp_two_pi_mul_int]

/-- The one-parameter subgroup of `Circle` generated by `circlePeriodOneGenerator` has period
one. -/
theorem periodic_mulInvariantExp_smul_circlePeriodOneGenerator :
    Function.Periodic
      (fun t : ℝ ↦ mulInvariantExp (I := 𝓡 1) (G := Circle) (t • circlePeriodOneGenerator)) 1 :=
  fun t ↦ by
    simp only [mulInvariantExp_smul_circlePeriodOneGenerator, mul_add, mul_one,
      Circle.exp_add_two_pi]

variable {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction Circle M]

section Flow

variable [FiniteDimensional ℝ E'] [I'.Boundaryless] [T2Space M] [IsManifold I' ∞ M]
  [ContMDiffSMul (𝓡 1) I' ∞ Circle M]

/-- For a smooth circle action, the flow of the fundamental vector field of
`circlePeriodOneGenerator` at time `t` is the action of `Circle.exp (2 * π * t)`. -/
theorem globalFlow_fundamentalVectorField_circlePeriodOneGenerator
    (hv : ContMDiff I' I'.tangent 1
      (fun x ↦ (⟨x, fundamentalVectorField I' circlePeriodOneGenerator x⟩ : TangentBundle I' M)))
    (hc : IsCompleteVectorField (fundamentalVectorField I' (M := M) circlePeriodOneGenerator))
    (t : ℝ) (x : M) :
    globalFlow (fundamentalVectorField I' circlePeriodOneGenerator) hv hc t x =
      Circle.exp (2 * π * t) • x := by
  rw [globalFlow_fundamentalVectorField, mulInvariantExp_smul_circlePeriodOneGenerator]

/-- For a smooth circle action, the flow of the fundamental vector field of
`circlePeriodOneGenerator` has period one. -/
theorem periodic_globalFlow_fundamentalVectorField_circlePeriodOneGenerator
    (hv : ContMDiff I' I'.tangent 1
      (fun x ↦ (⟨x, fundamentalVectorField I' circlePeriodOneGenerator x⟩ : TangentBundle I' M)))
    (hc : IsCompleteVectorField (fundamentalVectorField I' (M := M) circlePeriodOneGenerator)) :
    Function.Periodic (globalFlow (fundamentalVectorField I' circlePeriodOneGenerator) hv hc) 1 :=
  fun t ↦ funext fun x ↦ by
    simp only [globalFlow_fundamentalVectorField_circlePeriodOneGenerator, mul_add, mul_one,
      Circle.exp_add_two_pi]

end Flow

section FixedPoints

variable [IsManifold I' 1 M] [T2Space M] [BoundarylessManifold I' M]
  [ContMDiffSMul (𝓡 1) I' 2 Circle M]

/-- For a `C²` circle action on a Hausdorff manifold without boundary, a point is fixed by every
element of `Circle` exactly when the fundamental vector field of `circlePeriodOneGenerator`
vanishes there. -/
theorem mem_fixedPoints_circle_iff_fundamentalVectorField_eq_zero {x : M} :
    x ∈ MulAction.fixedPoints Circle M ↔
      fundamentalVectorField I' circlePeriodOneGenerator x = 0 := by
  refine ⟨fun hx ↦ fundamentalVectorField_eq_zero_of_forall_smul_eq hx _, fun hx g ↦ ?_⟩
  obtain ⟨t, rfl⟩ := mulInvariantExp_smul_circlePeriodOneGenerator_surjective g
  exact (mulInvariantExp_smul_smul_eq_iff (I' := I')).2 hx t

/-- For a `C²` circle action on a Hausdorff manifold without boundary, the fixed points of the
action are the zeros of the fundamental vector field of `circlePeriodOneGenerator`. -/
theorem fixedPoints_circle_eq_setOfPred_fundamentalVectorField_eq_zero :
    MulAction.fixedPoints Circle M =
      {x : M | fundamentalVectorField I' circlePeriodOneGenerator x = 0} :=
  Set.ext fun _ ↦ mem_fixedPoints_circle_iff_fundamentalVectorField_eq_zero

end FixedPoints

end SymplecticGeometry

end
