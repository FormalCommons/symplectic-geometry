/-!
# The leaf space of a foliation, and slices

For a foliation `𝓕` of a manifold `M`, this file defines the leaf space `𝓕.LeafSpace`: the
quotient of `M` by the relation `TauCeti.Foliation.SameLeaf` of lying on one leaf, with the
quotient topology. When `𝓕` is smooth and `M` is finite-dimensional and boundaryless, the
projection `𝓕.leafSpaceMk` is an open quotient map, since saturations of open sets are open
(`TauCeti.Foliation.isOpen_saturation`), so the leaf space of a second countable manifold is
second countable.

It then defines slices: for `𝓕` of rank `k` on a manifold modelled on `E`, a slice is a smooth
map `s` from an open set of `EuclideanSpace ℝ (Fin (finrank ℝ E - k))` to `M` whose differential
at each point has range complementary to the tangent space of `𝓕`, and which meets each leaf
at most once. The foliation is regular (condition (R) of McDuff–Salamon, §5.4) when every point
lies in the range of a slice. Near a point of a slice, the leaves give a smooth retraction onto
the slice (`TauCeti.Foliation.IsSlice.exists_retraction`): the transverse coordinate of a
foliated chart (`TauCeti.Foliation.exists_transverseCoordinate`), restricted to the slice, is a
local diffeomorphism by the inverse function theorem
(`TauCeti.isLocalDiffeomorphAt_of_injective_mfderiv`). It follows that the composition of a slice
with the projection to the leaf space is an open embedding
(`TauCeti.Foliation.IsSlice.isOpenEmbedding_leafSpaceMk_comp`). For a regular foliation these
open embeddings cover the leaf space (`TauCeti.Foliation.IsRegular.exists_isOpenEmbedding`), so
their inverses can serve as the charts of a smooth structure on the leaf space.

## Main definitions

* `TauCeti.Foliation.leafSetoid`, `TauCeti.Foliation.LeafSpace`, `TauCeti.Foliation.leafSpaceMk`:
  the leaf space and the projection onto it.
* `TauCeti.Foliation.IsSlice`: a slice of a foliation.
* `TauCeti.Foliation.IsRegular`: every point lies on a slice.

## Main results

* `TauCeti.Foliation.isOpenQuotientMap_leafSpaceMk`: the projection is an open quotient map.
* `TauCeti.Foliation.IsSlice.exists_retraction`: the retraction along leaves onto a slice.
* `TauCeti.Foliation.IsSlice.isOpenEmbedding_leafSpaceMk_comp`: a slice followed by the
  projection is an open embedding.
* `TauCeti.Foliation.IsRegular.exists_isOpenEmbedding`: for a regular foliation, such open
  embeddings cover the leaf space.

## References

* J. M. Lee, *Introduction to Smooth Manifolds*, 2nd ed., Springer GTM 218 (2013), Chapter 19
* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017], §5.4
-/

public section

noncomputable section

open Set Function Manifold Module TopologicalSpace Topology TauCeti.Manifold
open scoped Manifold ContDiff

namespace TauCeti

namespace Foliation

section LeafSpace

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {n : ℕ∞ω} [TopologicalSpace M] [ChartedSpace H M] {k : ℕ}
  [IsManifold I (n + 1) M] (𝓕 : Foliation I n M k)

/-- The setoid on `M` whose classes are the leaves of `𝓕`: the equivalence relation generated by
the curves tangent to `𝓕`, that is, `TauCeti.Foliation.SameLeaf`. -/
@[instance_reducible]
def leafSetoid : Setoid M :=
  ⟨𝓕.SameLeaf, 𝓕.sameLeaf_equivalence⟩

/-- The leaf space of `𝓕`: the set of its leaves, with the quotient topology. -/
def LeafSpace : Type _ :=
  Quotient 𝓕.leafSetoid

instance : TopologicalSpace 𝓕.LeafSpace :=
  inferInstanceAs (TopologicalSpace (Quotient 𝓕.leafSetoid))

/-- The projection sending a point to its leaf. -/
def leafSpaceMk : M → 𝓕.LeafSpace :=
  Quotient.mk 𝓕.leafSetoid

variable {𝓕}

theorem leafSetoid_iff {x y : M} : 𝓕.leafSetoid x y ↔ 𝓕.SameLeaf x y :=
  Iff.rfl

/-- Two points have the same image in the leaf space exactly when they lie on one leaf. -/
@[simp]
theorem leafSpaceMk_eq_leafSpaceMk_iff {x y : M} :
    𝓕.leafSpaceMk x = 𝓕.leafSpaceMk y ↔ 𝓕.SameLeaf x y :=
  Quotient.eq_iff_equiv.trans leafSetoid_iff

/-- Every leaf is the leaf of some point. -/
theorem leafSpaceMk_surjective : Surjective 𝓕.leafSpaceMk :=
  Quotient.mk_surjective

/-- The fibre of the projection through `x` is the leaf of `x`. -/
theorem preimage_leafSpaceMk_singleton (x : M) :
    𝓕.leafSpaceMk ⁻¹' {𝓕.leafSpaceMk x} = 𝓕.leaf x := by
  ext y
  simp [mem_leaf, sameLeaf_comm]

/-- **Induction on the leaf space**: a property of all leaves follows from the property of the leaf
of each point. -/
@[elab_as_elim]
theorem LeafSpace.ind {motive : 𝓕.LeafSpace → Prop} (h : ∀ x, motive (𝓕.leafSpaceMk x))
    (q : 𝓕.LeafSpace) : motive q :=
  Quotient.ind h q

/-- A map on `M` that is constant on each leaf descends to the leaf space. -/
def LeafSpace.lift {α : Sort*} (f : M → α) (hf : ∀ x y, 𝓕.SameLeaf x y → f x = f y) :
    𝓕.LeafSpace → α :=
  Quotient.lift f hf

@[simp]
theorem LeafSpace.lift_leafSpaceMk {α : Sort*} (f : M → α)
    (hf : ∀ x y, 𝓕.SameLeaf x y → f x = f y) (x : M) :
    LeafSpace.lift f hf (𝓕.leafSpaceMk x) = f x :=
  (rfl)

/-- The map induced on the leaf space, composed with the projection, is the original map. -/
@[simp]
theorem LeafSpace.lift_comp_leafSpaceMk {α : Sort*} (f : M → α)
    (hf : ∀ x y, 𝓕.SameLeaf x y → f x = f y) : LeafSpace.lift f hf ∘ 𝓕.leafSpaceMk = f :=
  funext (LeafSpace.lift_leafSpaceMk f hf)

/-- The projection to the leaf space is a quotient map. -/
theorem isQuotientMap_leafSpaceMk : IsQuotientMap 𝓕.leafSpaceMk :=
  isQuotientMap_quotient_mk'

/-- The projection to the leaf space is continuous. -/
@[continuity, fun_prop]
theorem continuous_leafSpaceMk : Continuous 𝓕.leafSpaceMk :=
  continuous_quotient_mk'

/-- A map on `M` that is constant on each leaf is continuous exactly when the map it induces on
the leaf space is. -/
theorem LeafSpace.continuous_lift_iff {α : Type*} [TopologicalSpace α] {f : M → α}
    {hf : ∀ x y, 𝓕.SameLeaf x y → f x = f y} : Continuous (LeafSpace.lift f hf) ↔ Continuous f := by
  rw [isQuotientMap_leafSpaceMk.continuous_iff, LeafSpace.lift_comp_leafSpaceMk]

/-- The map that a continuous map constant on each leaf induces on the leaf space is continuous. -/
theorem LeafSpace.continuous_lift {α : Type*} [TopologicalSpace α] {f : M → α}
    {hf : ∀ x y, 𝓕.SameLeaf x y → f x = f y} (h : Continuous f) :
    Continuous (LeafSpace.lift f hf) :=
  LeafSpace.continuous_lift_iff.2 h

/-- The preimage of the image of a set under the projection is the union of the leaves through
its points. -/
theorem preimage_image_leafSpaceMk (s : Set M) :
    𝓕.leafSpaceMk ⁻¹' (𝓕.leafSpaceMk '' s) = ⋃ x ∈ s, 𝓕.leaf x := by
  ext y
  simp [mem_leaf]

end LeafSpace

variable {E H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I (∞ + 1) M] [BoundarylessManifold I M] {k : ℕ}
  {𝓕 : Foliation I ∞ M k}

/-- The projection of a smooth foliation of a boundaryless manifold onto its leaf space is open. -/
theorem isOpenMap_leafSpaceMk : IsOpenMap 𝓕.leafSpaceMk := fun s hs ↦ by
  rw [← isQuotientMap_leafSpaceMk.isOpen_preimage, preimage_image_leafSpaceMk]
  exact 𝓕.isOpen_saturation hs

/-- The projection of a smooth foliation of a boundaryless manifold onto its leaf space is an open
quotient map. -/
theorem isOpenQuotientMap_leafSpaceMk : IsOpenQuotientMap 𝓕.leafSpaceMk :=
  ⟨leafSpaceMk_surjective, continuous_leafSpaceMk, isOpenMap_leafSpaceMk⟩

/-- The leaf space of a smooth foliation of a second countable boundaryless manifold is second
countable. -/
instance [SecondCountableTopology M] : SecondCountableTopology 𝓕.LeafSpace :=
  isOpenQuotientMap_leafSpaceMk.secondCountableTopology

variable (𝓕) in
/-- A slice of a foliation `𝓕` of rank `k` of a manifold modelled on `E`: a smooth map `s` from an
open set `U` of `EuclideanSpace ℝ (Fin (finrank ℝ E - k))` to `M` such that at each point the range
of the differential of `s` is a complement of the tangent space of `𝓕`, and no two points of `U`
are sent to the same leaf. -/
structure IsSlice {U : Opens (EuclideanSpace ℝ (Fin (finrank ℝ E - k)))} (s : U → M) : Prop where
  /-- A slice is smooth. -/
  contMDiff : ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) I ∞ s
  /-- The range of the differential of a slice is a complement of the tangent space of `𝓕`. -/
  isCompl_range_mfderiv (u : U) :
    IsCompl
      (LinearMap.range (mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) I s u).toLinearMap)
      (𝓕.distribution (s u))
  /-- A slice meets each leaf at most once. -/
  injective_of_sameLeaf (u v : U) : 𝓕.SameLeaf (s u) (s v) → u = v

variable (𝓕) in
/-- A foliation is regular when every point lies in the range of a slice. -/
def IsRegular : Prop :=
  ∀ x : M, ∃ (U : Opens (EuclideanSpace ℝ (Fin (finrank ℝ E - k)))) (s : U → M), 𝓕.IsSlice s ∧
    x ∈ range s

omit [FiniteDimensional ℝ E] [BoundarylessManifold I M] in
/-- A foliation is regular exactly when every point lies in the range of a slice. -/
theorem isRegular_def : 𝓕.IsRegular ↔ ∀ x : M,
    ∃ (U : Opens (EuclideanSpace ℝ (Fin (finrank ℝ E - k)))) (s : U → M), 𝓕.IsSlice s ∧
      x ∈ range s :=
  Iff.rfl

namespace IsSlice

variable {U : Opens (EuclideanSpace ℝ (Fin (finrank ℝ E - k)))} {s : U → M}

omit [FiniteDimensional ℝ E] [BoundarylessManifold I M] in
/-- A slice is injective. -/
theorem injective (hs : 𝓕.IsSlice s) : Injective s :=
  fun u v h ↦ hs.injective_of_sameLeaf u v (h ▸ SameLeaf.refl 𝓕 _)

omit [BoundarylessManifold I M] in
/-- The differential of a slice is injective: its range is a complement of a subspace of
dimension `k` in a space of dimension `finrank ℝ E`. -/
theorem injective_mfderiv (hs : 𝓕.IsSlice s) (u : U) :
    Injective (mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) I s u) := by
  have hk : k ≤ finrank ℝ E := 𝓕.finrank_distribution (s u) ▸ Submodule.finrank_le _
  rw [← ContinuousLinearMap.coe_coe]
  refine LinearMap.injective_of_isCompl_range (hs.isCompl_range_mfderiv u) ?_
  rw [𝓕.finrank_distribution]
  -- The tangent spaces are the model spaces, by the definition of `TangentSpace`.
  change finrank ℝ (EuclideanSpace ℝ (Fin (finrank ℝ E - k))) + k = finrank ℝ E
  rw [finrank_euclideanSpace_fin]
  omega

/-- **The retraction onto a slice along the leaves.** Near a point `s u` of a slice `s` of a smooth
foliation of a boundaryless manifold, there is a map `r` to the domain of `s`, smooth at `s u`,
such that `r (s v) = v` for `v` near `u`, every `z` near `s u` lies on the leaf of `s (r z)`, and
the differential of `r` at `s u` vanishes on the tangent space of `𝓕`. -/
theorem exists_retraction (hs : 𝓕.IsSlice s) (u : U) :
    ∃ r : M → U, ContMDiffAt I 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) ∞ r (s u) ∧
      (∀ᶠ v in 𝓝 u, r (s v) = v) ∧ (∀ᶠ z in 𝓝 (s u), 𝓕.SameLeaf z (s (r z))) ∧
      ∀ v ∈ 𝓕.distribution (s u),
        mfderiv I 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) r (s u) v = 0 := by
  have hk : k ≤ finrank ℝ E := 𝓕.finrank_distribution (s u) ▸ Submodule.finrank_le _
  obtain ⟨V, ψ, hxV, hψ, hker, hleaf⟩ := 𝓕.exists_transverseCoordinate
    (F₂ := EuclideanSpace ℝ (Fin (finrank ℝ E - k))) (by rw [finrank_euclideanSpace_fin]; omega)
    (s u)
  -- The transverse coordinate along the slice is a local diffeomorphism at `u`.
  have hW : IsOpen (s ⁻¹' V) := V.isOpen.preimage hs.contMDiff.continuous
  have hh : ContMDiffOn 𝓘(ℝ, _) 𝓘(ℝ, _) ∞ (ψ ∘ s) (s ⁻¹' V) := fun v hv ↦
    ((hψ _ hv).comp v (hs.contMDiff v)).contMDiffWithinAt
  have hinj : Injective (mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k)))
      𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) (ψ ∘ s) u) := by
    rw [← ContinuousLinearMap.coe_coe, ← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro w hw
    rw [ContinuousLinearMap.coe_coe, mfderiv_comp_apply u
      ((hψ _ hxV).mdifferentiableAt (by simp))
      ((hs.contMDiff u).mdifferentiableAt (by simp))] at hw
    have h0 := Submodule.disjoint_def.1 (hs.isCompl_range_mfderiv u).disjoint _
      (LinearMap.mem_range_self _ w) ((hker _ hxV _).1 hw)
    exact (hs.injective_mfderiv u) (h0.trans (map_zero _).symm)
  have hL : IsLocalDiffeomorphAt 𝓘(ℝ, _) 𝓘(ℝ, _) ∞ (ψ ∘ s) u :=
    isLocalDiffeomorphAt_of_injective_mfderiv hh hW hxV BoundarylessManifold.isInteriorPoint
      (by simp) hinj rfl
  -- The retraction is the local inverse after the transverse coordinate.
  set Λ := hL.localInverse
  have hr : ContMDiffAt I 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) ∞ (fun z ↦ Λ (ψ z))
      (s u) :=
    hL.contMDiffAt_localInverse.comp (s u) (hψ _ hxV)
  have hru : Λ (ψ (s u)) = u := hL.localInverse_left_inv hL.localInverse_mem_target
  refine ⟨fun z ↦ Λ (ψ z), hr, hL.localInverse_eventuallyEq_left.mono fun v hv ↦ hv, ?_, ?_⟩
  rotate_left
  · intro v hv
    have hΛ : MDifferentiableAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k)))
        𝓘(ℝ, EuclideanSpace ℝ (Fin (finrank ℝ E - k))) Λ (ψ (s u)) :=
      hL.contMDiffAt_localInverse.mdifferentiableAt (by simp)
    refine (mfderiv_comp_apply (s u) hΛ ((hψ _ hxV).mdifferentiableAt (by simp)) v).trans ?_
    rw [(hker _ hxV v).2 hv, map_zero]
  have h₁ : ∀ᶠ z in 𝓝 (s u), ψ z ∈ Λ.source :=
    (hψ _ hxV).continuousAt.preimage_mem_nhds
      (hL.localInverse_open_source.mem_nhds hL.localInverse_mem_source)
  have h₂ : ∀ᶠ z in 𝓝 (s u), s (Λ (ψ z)) ∈ V := by
    have hc : ContinuousAt (fun z ↦ s (Λ (ψ z))) (s u) :=
      hs.contMDiff.continuous.continuousAt.comp hr.continuousAt
    exact hc.preimage_mem_nhds (by simpa only [hru] using V.isOpen.mem_nhds hxV)
  filter_upwards [V.isOpen.mem_nhds hxV, h₁, h₂] with z hz hz₁ hz₂
  exact hleaf z hz _ hz₂ (hL.localInverse_right_inv hz₁).symm

/-- A slice of a smooth foliation of a boundaryless manifold, followed by the projection to the
leaf space, is an open embedding. -/
theorem isOpenEmbedding_leafSpaceMk_comp (hs : 𝓕.IsSlice s) :
    IsOpenEmbedding (𝓕.leafSpaceMk ∘ s) := by
  refine .of_continuous_injective_isOpenMap (continuous_leafSpaceMk.comp hs.contMDiff.continuous)
    (fun u v huv ↦ hs.injective_of_sameLeaf u v (leafSpaceMk_eq_leafSpaceMk_iff.1 huv))
    fun W hW ↦ isOpen_iff_forall_mem_open.2 ?_
  rintro _ ⟨u, hu, rfl⟩
  obtain ⟨r, hr, hrs, hleaf, -⟩ := hs.exists_retraction u
  have hru : r (s u) = u := hrs.self_of_nhds
  have hrW : r ⁻¹' W ∈ 𝓝 (s u) :=
    hr.continuousAt.preimage_mem_nhds (by rw [hru]; exact hW.mem_nhds hu)
  obtain ⟨O, hOsub, hO, hsO⟩ := mem_nhds_iff.1 (Filter.inter_mem hrW hleaf)
  refine ⟨𝓕.leafSpaceMk '' O, ?_, isOpenMap_leafSpaceMk O hO, mem_image_of_mem _ hsO⟩
  rintro _ ⟨z, hz, rfl⟩
  exact ⟨r z, (hOsub hz).1, leafSpaceMk_eq_leafSpaceMk_iff.2 (hOsub hz).2.symm⟩

end IsSlice

/-- For a regular foliation, every leaf lies in the image of the composition `𝓕.leafSpaceMk ∘ s` of
a slice `s` with the projection, and this composition is an open embedding. -/
theorem IsRegular.exists_isOpenEmbedding (h𝓕 : 𝓕.IsRegular) (q : 𝓕.LeafSpace) :
    ∃ (U : Opens (EuclideanSpace ℝ (Fin (finrank ℝ E - k)))) (s : U → M), 𝓕.IsSlice s ∧
      IsOpenEmbedding (𝓕.leafSpaceMk ∘ s) ∧ q ∈ range (𝓕.leafSpaceMk ∘ s) := by
  obtain ⟨x, rfl⟩ := leafSpaceMk_surjective q
  obtain ⟨U, s, hs, u, rfl⟩ := h𝓕 x
  exact ⟨U, s, hs, hs.isOpenEmbedding_leafSpaceMk_comp, u, rfl⟩

end Foliation

end TauCeti

