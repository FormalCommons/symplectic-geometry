/-!
# Van Kampen for a connected sum, the neck included

Tau Ceti computes the fundamental group of a connected sum `TauCeti.ConnectedSum e₁ e₂` in
dimension at least three (`TauCeti.ConnectedSum.fundamentalGroupMulEquiv`), where the neck, the
overlap of the two punctured summands, is simply connected. This file gives the van Kampen square
in every dimension at least two, with the neck kept: the overlap is the punctured model space
`{0}ᶜ ⊆ E`, mapped to the first punctured summand by `v ↦ e₁ v` (`neckInl`) and to the second by
`v ↦ e₂ (inversion 0 1 v)` (`neckInr`).

## Main results

* `TauCeti.ConnectedSum.isPushout_fundamentalGroup`: for connected manifolds `M` and `N` modelled
  on a real inner product space of dimension at least two, the square of fundamental groups
  formed by `neckInl`, `neckInr` and the inclusions `inl`, `inr` of the punctured summands into
  the connected sum is a pushout of groups.
* `TauCeti.ConnectedSum.neckFundamentalGroupMulEquivInt`: when `E` is a plane, identified with
  `ℂ` by a linear isometry `φ`, the fundamental group of the neck is `ℤ`;
  `TauCeti.ConnectedSum.neckFundamentalGroupMulEquivInt_neckLoop`: it is generated by the circle
  `neckLoop φ hr : t ↦ φ (r e^{2πit})`.
* `TauCeti.ConnectedSum.coe_map_neckInl_neckLoop_apply`,
  `TauCeti.ConnectedSum.coe_map_neckInr_neckLoop_apply`: in the first summand this circle is
  `t ↦ e₁ (φ (r e^{2πit}))`, and in the second, through the inversion, the circle
  `t ↦ e₂ (φ (r⁻¹ e^{2πit}))` of radius `r⁻¹`, at the same angle.

All spaces are taken in one universe, as the pushout is a square in `GrpCat`.

The embedding of the neck into the connected sum, `neckMap`, and its two properties
`isEmbedding_neckMap` and `range_neckMap`, adapt the private declarations of the same names in
Tau Ceti's `TauCeti/Geometry/Manifold/ConnectedSum/FundamentalGroup.lean`, and the square is
`TauCeti.isPushout_fundamentalGroup` transported along homeomorphisms, as in Tau Ceti's
`TauCeti.isPushout_fundamentalGroup_union`. The generator of the neck is transported from
`StarConvex.fundamentalGroupMulEquivInt_sphereLoop`.

## References

* A. Hatcher, *Algebraic Topology*, Cambridge University Press, 2002, §1.2 (the Seifert–van Kampen
  theorem) and Theorem 1.7 (`π₁(S¹) ≅ ℤ`).
-/

public section

open Set Function Topology CategoryTheory EuclideanGeometry

namespace TauCeti.ConnectedSum

universe u

variable {E M N : Type u} [NormedAddCommGroup E]
  [TopologicalSpace M] [T1Space M] [TopologicalSpace N] [T1Space N]
  {e₁ : E → M} {e₂ : E → N}

/-- The map `v ↦ e₁ v` from the punctured model space to the first punctured summand. -/
def neckInl (h₁ : IsOpenEmbedding e₁) : C(({0}ᶜ : Set E), puncture e₁) where
  toFun v := ⟨e₁ v, mem_puncture.2 (h₁.injective.ne v.property)⟩
  continuous_toFun := (h₁.continuous.comp continuous_subtypeVal).subtype_mk _

@[simp]
theorem coe_neckInl_apply (h₁ : IsOpenEmbedding e₁) (v : ({0}ᶜ : Set E)) :
    (neckInl h₁ v : M) = e₁ v :=
  (rfl)

variable [InnerProductSpace ℝ E]

/-- The map `v ↦ e₂ (inversion 0 1 v)` from the punctured model space to the second punctured
summand. -/
noncomputable def neckInr (h₂ : IsOpenEmbedding e₂) : C(({0}ᶜ : Set E), puncture e₂) where
  toFun v := ⟨e₂ (inversion 0 1 v), apply_inversion_mem_puncture h₂.injective v.property⟩
  continuous_toFun := (h₂.continuous.comp (continuous_const.inversion continuous_const
    continuous_subtypeVal fun v ↦ v.property)).subtype_mk _

@[simp]
theorem coe_neckInr_apply (h₂ : IsOpenEmbedding e₂) (v : ({0}ᶜ : Set E)) :
    (neckInr h₂ v : N) = e₂ (inversion 0 1 v) :=
  (rfl)

/-- The two maps of the neck agree in the connected sum. -/
theorem inl_neckInl_eq_inr_neckInr (h₁ : IsOpenEmbedding e₁) (h₂ : IsOpenEmbedding e₂)
    (v : ({0}ᶜ : Set E)) : inl e₁ e₂ (neckInl h₁ v) = inr e₁ e₂ (neckInr h₂ v) :=
  inl_eq_inr (v : E) _ _

/-- The neck embedded in the connected sum. -/
private def neckMap (h₁ : IsOpenEmbedding e₁) : ({0}ᶜ : Set E) → ConnectedSum e₁ e₂ :=
  fun v ↦ inl e₁ e₂ (neckInl h₁ v)

private theorem isEmbedding_neckMap (h₁ : IsOpenEmbedding e₁) (h₂ : IsOpenEmbedding e₂) :
    IsEmbedding (neckMap (e₂ := e₂) h₁) := by
  have he : IsEmbedding (neckInl h₁) :=
    IsEmbedding.subtypeVal.of_comp_iff.mp (h₁.isEmbedding.comp IsEmbedding.subtypeVal)
  exact (isOpenEmbedding_inl h₁ h₂).isEmbedding.comp he

private theorem range_neckMap (h₁ : IsOpenEmbedding e₁) (h₂ : IsOpenEmbedding e₂) :
    range (neckMap (e₂ := e₂) h₁) = range (inl e₁ e₂) ∩ range (inr e₁ e₂) := by
  ext z
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨⟨_, rfl⟩, ⟨_, (inl_neckInl_eq_inr_neckInr h₁ h₂ v).symm⟩⟩
  · rintro ⟨⟨x, rfl⟩, y, hy⟩
    obtain ⟨v, hv, hvx, -⟩ := (inl_eq_inr_iff h₁.injective).1 hy.symm
    exact ⟨⟨v, hv⟩, congrArg (inl e₁ e₂) (Subtype.ext hvx)⟩

section VanKampen

variable [ChartedSpace E M] [ChartedSpace E N]
  [ConnectedSpace M] [ConnectedSpace N]

/-- **Van Kampen for a connected sum.** For connected manifolds `M` and `N` modelled on a real
inner product space `E` of dimension at least two, and open embeddings `e₁ : E → M` and
`e₂ : E → N`, the square of fundamental groups formed by the maps `neckInl` and `neckInr` of the
punctured model space `{0}ᶜ ⊆ E` into the punctured summands, and by the inclusions `inl` and
`inr` of the punctured summands into the connected sum, is a pushout of groups. The basepoint is
any `v ≠ 0`; the image of the second summand is based at the point
`inr (neckInr v) = inl (neckInl v)`. -/
theorem isPushout_fundamentalGroup (h : 1 < Module.rank ℝ E) (h₁ : IsOpenEmbedding e₁)
    (h₂ : IsOpenEmbedding e₂) (v : ({0}ᶜ : Set E)) :
    IsPushout
      (GrpCat.ofHom (FundamentalGroup.map (neckInl h₁) v))
      (GrpCat.ofHom (FundamentalGroup.map (neckInr h₂) v))
      (GrpCat.ofHom (FundamentalGroup.map ⟨inl e₁ e₂, continuous_inl e₁ e₂⟩ (neckInl h₁ v)))
      (GrpCat.ofHom (FundamentalGroup.mapOfEq ⟨inr e₁ e₂, continuous_inr e₁ e₂⟩
        (inl_neckInl_eq_inr_neckInr h₁ h₂ v).symm)) := by
  set x := inl e₁ e₂ (neckInl h₁ v)
  have hxA : x ∈ range (inl e₁ e₂) := ⟨_, rfl⟩
  have hxB : x ∈ range (inr e₁ e₂) := ⟨_, (inl_neckInl_eq_inr_neckInr h₁ h₂ v).symm⟩
  have hCover : interior (range (inl e₁ e₂)) ∪ interior (range (inr e₁ e₂)) = univ := by
    rw [(isOpenEmbedding_inl h₁ h₂).isOpen_range.interior_eq,
      (isOpenEmbedding_inr h₁ h₂).isOpen_range.interior_eq, range_inl_union_range_inr]
  have hA : IsPathConnected (range (inl e₁ e₂)) := by
    rw [← image_univ]
    have : PathConnectedSpace (puncture e₁ : Set M) := by
      rw [← isPathConnected_iff_pathConnectedSpace, coe_puncture]
      exact isPathConnected_compl_of_finite_of_one_lt_rank h (finite_singleton (e₁ 0))
    exact isPathConnected_univ.image (continuous_inl e₁ e₂)
  have hB : IsPathConnected (range (inr e₁ e₂)) := by
    rw [← image_univ]
    have : PathConnectedSpace (puncture e₂ : Set N) := by
      rw [← isPathConnected_iff_pathConnectedSpace, coe_puncture]
      exact isPathConnected_compl_of_finite_of_one_lt_rank h (finite_singleton (e₂ 0))
    exact isPathConnected_univ.image (continuous_inr e₁ e₂)
  have hAB : IsPathConnected (range (inl e₁ e₂) ∩ range (inr e₁ e₂)) := by
    rw [← range_neckMap h₁ h₂, ← image_univ]
    have : PathConnectedSpace ({0}ᶜ : Set E) :=
      isPathConnected_iff_pathConnectedSpace.mp
        (isPathConnected_compl_singleton_of_one_lt_rank h 0)
    exact isPathConnected_univ.image (isEmbedding_neckMap h₁ h₂).continuous
  let σ₀ : ({0}ᶜ : Set E) ≃ₜ ↥(range (inl e₁ e₂) ∩ range (inr e₁ e₂)) :=
    (isEmbedding_neckMap h₁ h₂).toHomeomorph.trans (Homeomorph.setCongr (range_neckMap h₁ h₂))
  let σ₁ := (isOpenEmbedding_inl h₁ h₂).isEmbedding.toHomeomorph
  let σ₂ := (isOpenEmbedding_inr h₁ h₂).isEmbedding.toHomeomorph
  have h₀ : σ₀ v = ⟨x, hxA, hxB⟩ := rfl
  have hσ₁ : σ₁ (neckInl h₁ v) = ⟨x, hxA⟩ := rfl
  have hσ₂ : σ₂ (neckInr h₂ v) = ⟨x, hxB⟩ :=
    Subtype.ext (inl_neckInl_eq_inr_neckInr h₁ h₂ v).symm
  refine (TauCeti.isPushout_fundamentalGroup hCover hA hB hAB hxA hxB).of_iso'
    (FundamentalGroup.homeomorphMulEquivOfEq σ₀ h₀).toGrpIso
    (FundamentalGroup.homeomorphMulEquivOfEq σ₁ hσ₁).toGrpIso
    (FundamentalGroup.homeomorphMulEquivOfEq σ₂ hσ₂).toGrpIso (Iso.refl _) ?_ ?_ ?_ ?_
  -- Each of the four squares comes from a square of continuous maps that commutes pointwise.
  -- `erw` evaluates the isomorphisms `MulEquiv.toGrpIso` on the carriers `GrpCat.of`, which
  -- `simp` leaves on one side of the two squares out of the neck.
  all_goals
    try rw [Iso.refl_hom, Category.comp_id]
    refine GrpCat.ext fun p ↦ ?_
    simp only [GrpCat.hom_comp, GrpCat.hom_ofHom, MonoidHom.coe_comp, Function.comp_apply,
      MulEquiv.toGrpIso_hom, MulEquiv.coe_toMonoidHom,
      FundamentalGroup.homeomorphMulEquivOfEq_apply, ← FundamentalGroup.mapOfEq_rfl]
    erw [MulEquiv.toGrpIso_hom, GrpCat.hom_ofHom, MulEquiv.coe_toMonoidHom,
      FundamentalGroup.homeomorphMulEquivOfEq_apply]
    first
    | refine FundamentalGroup.mapOfEq_mapOfEq_eq_mapOfEq_mapOfEq ?_ _ _ _ _ p
    | refine FundamentalGroup.mapOfEq_mapOfEq_eq_mapOfEq ?_ _ _ _ p
    ext w
    first
    | rfl
    | exact inl_neckInl_eq_inr_neckInr h₁ h₂ w

end VanKampen

section Plane

/-! ### The neck of a connected sum of surfaces

For a plane `E`, identified with `ℂ` by a linear isometry `φ : ℂ ≃ₗᵢ[ℝ] E`, the neck `{0}ᶜ ⊆ E`
has infinite cyclic fundamental group, generated by the circle `t ↦ φ (r e^{2πit})`. -/

variable (φ : ℂ ≃ₗᵢ[ℝ] E) {r : ℝ} (hr : 0 < r)

/-- The punctured plane `ℂ ∖ {0}`, as Tau Ceti's `StarConvex` API writes it, is homeomorphic to
the punctured model space by `φ`. -/
noncomputable def neckHomeomorph : ↥((univ : Set ℂ) \ {0}) ≃ₜ ({0}ᶜ : Set E) :=
  φ.toHomeomorph.subtype fun z ↦ by simp

@[simp]
theorem coe_neckHomeomorph_apply (z : ↥((univ : Set ℂ) \ {0})) :
    (neckHomeomorph φ z : E) = φ z :=
  (rfl)

/-- The point `φ r` of the neck, the basepoint of `neckLoop φ hr`. -/
noncomputable def neckBase : ({0}ᶜ : Set E) :=
  ⟨φ r, by simpa using hr.ne'⟩

@[simp]
theorem coe_neckBase : (neckBase φ hr : E) = φ r :=
  (rfl)

/-- The loop `t ↦ φ (r e^{2πit})` in the neck, going once around the puncture, counterclockwise
in the coordinates `φ`. -/
noncomputable def neckLoop : Path (neckBase φ hr) (neckBase φ hr) where
  toFun t := ⟨φ (circleMap 0 r (2 * Real.pi * t)), by simpa using hr.ne'⟩
  continuous_toFun := by unfold circleMap; fun_prop
  source' := by ext; simp [circleMap]
  target' := by ext; simp [circleMap]

@[simp]
theorem coe_neckLoop_apply (t : unitInterval) :
    (neckLoop φ hr t : E) = φ (circleMap 0 r (2 * Real.pi * t)) :=
  (rfl)

/-- The basepoint of `StarConvex.fundamentalGroupMulEquivInt` is carried to `neckBase φ hr`. -/
private theorem neckHomeomorph_sphereHomotopyEquiv :
    neckHomeomorph φ ((starConvex_univ 0).sphereHomotopyEquiv hr (subset_univ _)
      ((sphereCircleHomeomorph 0 hr).symm 1)) = neckBase φ hr :=
  Subtype.ext (by simp)

/-- **The neck of a connected sum of surfaces has fundamental group `ℤ`.** For a plane `E`
identified with `ℂ` by `φ`, the fundamental group of `{0}ᶜ ⊆ E` is infinite cyclic. It is the
isomorphism `StarConvex.fundamentalGroupMulEquivInt` of `ℂ ∖ {0}`, carried over by `φ`. -/
noncomputable def neckFundamentalGroupMulEquivInt :
    FundamentalGroup ({0}ᶜ : Set E) (neckBase φ hr) ≃* Multiplicative ℤ :=
  (FundamentalGroup.homeomorphMulEquivOfEq (neckHomeomorph φ)
    (neckHomeomorph_sphereHomotopyEquiv φ hr)).symm.trans
      ((starConvex_univ 0).fundamentalGroupMulEquivInt hr (subset_univ _) _)

/-- The loop `neckLoop φ hr` generates the fundamental group of the neck: it corresponds to
`1 : ℤ`. -/
theorem neckFundamentalGroupMulEquivInt_neckLoop :
    neckFundamentalGroupMulEquivInt φ hr
        (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk (neckLoop φ hr))) =
      Multiplicative.ofAdd 1 := by
  -- Carried to `ℂ ∖ {0}`, the loop is `Complex.sphereLoop`, up to the basepoint equation.
  have key : ∀ (y : ({0}ᶜ : Set E)) (hy : neckHomeomorph φ ((starConvex_univ 0).sphereHomotopyEquiv
      hr (subset_univ _) ((sphereCircleHomeomorph 0 hr).symm 1)) = y) (γ : Path y y),
      (∀ t, (γ t : E) = φ (circleMap 0 r (2 * Real.pi * t))) →
      FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk γ) =
        FundamentalGroup.homeomorphMulEquivOfEq (neckHomeomorph φ) hy
          (FundamentalGroup.map ((starConvex_univ 0).sphereHomotopyEquiv hr (subset_univ _)).toFun
            _ (FundamentalGroup.fromPath
              (Path.Homotopic.Quotient.mk (Complex.sphereLoop 0 hr)))) := by
    rintro y rfl γ hγ
    rw [FundamentalGroup.homeomorphMulEquivOfEq_apply, FundamentalGroup.mapOfEq_rfl,
      TauCeti.FundamentalGroup.map_fromPath, TauCeti.FundamentalGroup.map_fromPath, Path.map_map]
    congr 2
    ext t
    simp [hγ]
  rw [neckFundamentalGroupMulEquivInt, MulEquiv.trans_apply, (MulEquiv.symm_apply_eq _).mpr
    (key _ (neckHomeomorph_sphereHomotopyEquiv φ hr) _ (coe_neckLoop_apply φ hr)),
    StarConvex.fundamentalGroupMulEquivInt_sphereLoop]

end Plane

section Summands

variable {φ : ℂ ≃ₗᵢ[ℝ] E} {r : ℝ} {hr : 0 < r}

/-- In the first punctured summand the neck loop is the circle `t ↦ e₁ (φ (r e^{2πit}))`. -/
theorem coe_map_neckInl_neckLoop_apply (h₁ : IsOpenEmbedding e₁) (t : unitInterval) :
    ((neckLoop φ hr).map (neckInl h₁).continuous t : M) =
      e₁ (φ (circleMap 0 r (2 * Real.pi * t))) := by
  simp

/-- In the second punctured summand the neck loop is the circle `t ↦ e₂ (φ (r⁻¹ e^{2πit}))`: the
inversion keeps the angle and inverts the radius. -/
theorem coe_map_neckInr_neckLoop_apply (h₂ : IsOpenEmbedding e₂) (t : unitInterval) :
    ((neckLoop φ hr).map (neckInr h₂).continuous t : N) =
      e₂ (φ (circleMap 0 r⁻¹ (2 * Real.pi * t))) := by
  simp only [Path.map_coe, Function.comp_apply, coe_neckInr_apply, coe_neckLoop_apply,
    ← φ.map_inversion_zero]
  congr 2
  simp only [inversion, dist_zero_right, norm_circleMap_zero, abs_of_pos hr, vsub_eq_sub,
    sub_zero, vadd_eq_add, add_zero]
  simp only [circleMap_zero, Complex.real_smul]
  push_cast
  field_simp

end Summands

end TauCeti.ConnectedSum

