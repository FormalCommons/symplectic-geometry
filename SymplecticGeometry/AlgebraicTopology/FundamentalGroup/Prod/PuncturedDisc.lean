module

public import Mathlib.AlgebraicTopology.FundamentalGroupoid.FundamentalGroup
public import Mathlib.Topology.Homotopy.Product
public import TauCeti.Topology.Homotopy.PuncturedStarConvex

import Mathlib.Analysis.Convex.Contractible
import SymplecticGeometry.AlgebraicTopology.FundamentalGroup.Prod.Basic
import TauCeti.AlgebraicTopology.FundamentalGroup.Basic
import TauCeti.AlgebraicTopology.FundamentalGroup.PuncturedStarConvex

/-!
# Filling in the puncture of a disc in a product

Let `Q` be a topological space and `ball p R \ {p}` a punctured disc in `ℂ`. This file computes
the homomorphism of fundamental groups induced by the inclusion
`Q × (ball p R \ {p}) → Q × ball p R`, at a basepoint `(q, z)`: it is surjective, and its kernel
is the subgroup generated by the class of the loop `t ↦ (q, p + (z - p) e^{2πit})` going once
around the puncture, which is also its normal closure.

The disc is convex, hence simply connected, so `FundamentalGroup.map_id_prodMap_surjective` and
`FundamentalGroup.ker_map_id_prodMap` with `FundamentalGroup.ker_map_fst_eq_range` (in
`Prod/Basic.lean`) give surjectivity and identify the kernel with the classes of loops in the
slice `{q} × (ball p R \ {p})`. Tau Ceti's `TauCeti.zpowers_loopAround_eq_top`, applied with a
point as the simply connected factor, shows that the loop around the puncture generates the
fundamental group of that slice.

## Main results

* `FundamentalGroup.map_prodMap_inclusion_ball_diff_singleton_surjective`: the inclusion
  induces a surjection.
* `FundamentalGroup.ker_map_prodMap_inclusion_ball_diff_singleton`: its kernel is generated
  by the class of the loop around the puncture.
* `FundamentalGroup.ker_map_prodMap_inclusion_ball_diff_singleton_eq_normalClosure`: the same
  kernel is the normal closure of that class.

## References

* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Cambridge University Press, 2002, Proposition 1.12 and Theorem 1.7.
-/

public section

open Metric Set

namespace FundamentalGroup

variable {Q : Type*} [TopologicalSpace Q] {p : ℂ} {R : ℝ}

/-- **Filling in the puncture is surjective on fundamental groups.** The inclusion
`Q × (ball p R \ {p}) → Q × ball p R` induces a surjection of fundamental groups at every
basepoint. -/
theorem map_prodMap_inclusion_ball_diff_singleton_surjective (q : Q) (z : ↥(ball p R \ {p})) :
    Function.Surjective (map ((ContinuousMap.id Q).prodMap
      (ContinuousMap.inclusion (sdiff_subset : ball p R \ {p} ⊆ ball p R))) (q, z)) :=
  have : ContractibleSpace (ball p R) := (convex_ball p R).contractibleSpace ⟨z, z.property.1⟩
  map_id_prodMap_surjective _ q z

/-- **The kernel of filling in the puncture.** The kernel of the map of fundamental groups
induced by the inclusion `Q × (ball p R \ {p}) → Q × ball p R` at `(q, z)` is the subgroup
generated by the class of the loop `t ↦ (q, p + (z - p) e^{2πit})` around the puncture. -/
theorem ker_map_prodMap_inclusion_ball_diff_singleton (q : Q) (z : ↥(ball p R \ {p})) :
    (map ((ContinuousMap.id Q).prodMap
      (ContinuousMap.inclusion (sdiff_subset : ball p R \ {p} ⊆ ball p R))) (q, z)).ker =
      Subgroup.zpowers (fromPath (Path.Homotopic.Quotient.mk
        ((Path.refl q).prod (p.loopAround z)))) := by
  have : ContractibleSpace (ball p R) := (convex_ball p R).contractibleSpace ⟨z, z.property.1⟩
  rw [ker_map_id_prodMap, ker_map_fst_eq_range, MonoidHom.range_eq_map,
    ← TauCeti.zpowers_loopAround_eq_top () z, MonoidHom.map_zpowers]
  -- the slice inclusion maps the loop `t ↦ ((), loopAround z t)` to `t ↦ (q, loopAround z t)`
  -- pointwise by definition, so the mapped path is the product path on the nose
  exact congrArg Subgroup.zpowers (TauCeti.FundamentalGroup.map_fromPath _ ((), z) _)

/-- **The kernel of filling in the puncture is normally generated by the loop around it.** The
kernel of the map of fundamental groups induced by the inclusion
`Q × (ball p R \ {p}) → Q × ball p R` at `(q, z)` is the normal closure of the class of the loop
`t ↦ (q, p + (z - p) e^{2πit})` around the puncture. -/
theorem ker_map_prodMap_inclusion_ball_diff_singleton_eq_normalClosure (q : Q)
    (z : ↥(ball p R \ {p})) :
    (map ((ContinuousMap.id Q).prodMap
      (ContinuousMap.inclusion (sdiff_subset : ball p R \ {p} ⊆ ball p R))) (q, z)).ker =
      Subgroup.normalClosure {fromPath (Path.Homotopic.Quotient.mk
        ((Path.refl q).prod (p.loopAround z)))} := by
  refine le_antisymm ?_ (Subgroup.normalClosure_le_normal ?_)
  · rw [ker_map_prodMap_inclusion_ball_diff_singleton, Subgroup.zpowers_le]
    exact Subgroup.subset_normalClosure rfl
  · rw [singleton_subset_iff, SetLike.mem_coe, ker_map_prodMap_inclusion_ball_diff_singleton]
    exact Subgroup.mem_zpowers _

end FundamentalGroup

end
