module

public import Mathlib.Topology.PartitionOfUnity
public import TauCeti.AlgebraicTopology.SimplicialComplex.Realization.Basic
import SymplecticGeometry.AlgebraicTopology.SimplicialComplex.Realization.Restriction
import TauCeti.AlgebraicTopology.SimplicialComplex.Basic
import TauCeti.AlgebraicTopology.SimplicialComplex.Realization.Coordinates

/-!
# The nerve of a partition of unity

For a partition of unity `ρ` on `X` indexed by `ι`, the nerve `ρ.nerve` is the abstract
simplicial complex on `ι` whose faces are the nonempty finite sets of indices `t` such that the
functions `ρ i`, `i ∈ t`, are all nonzero at one point of `X`, that is, the precomplex
generated by the sets `ρ.finsupport x` (`TauCeti.PreAbstractSimplicialComplex.ofGenerators`).
Since Mathlib's `AbstractSimplicialComplex` has every singleton as a face, while some `ρ i` may
vanish everywhere, the nerve also contains all singletons
(`PreAbstractSimplicialComplex.addSingletons`); these extra vertices are isolated.

The canonical map `ρ.toNerve : C(X, ρ.nerve.Realization)` sends `x` to the point of the weak
realization with barycentric coordinates `ρ i x`. It is continuous because `ρ` is locally finite:
near each point its values are supported on finitely many vertices
(`AbstractSimplicialComplex.continuous_of_forall_eventually_support_subset`).

## Main definitions

* `PartitionOfUnity.nerve`: the nerve of a partition of unity.
* `PartitionOfUnity.toNerve`: the canonical map from `X` to the realization of the nerve.

## Main results

* `PartitionOfUnity.mem_nerve_iff`: the faces of the nerve.
* `PartitionOfUnity.toNerve_apply_coe`: the barycentric coordinates of `ρ.toNerve x` are the
  values `ρ i x`.

## References

* J. Milnor, *On spaces having the homotopy type of a CW-complex*, Trans. Amer. Math. Soc. 90
  (1959), 272–280.
* J. Dugundji, *An extension of Tietze's theorem*, Pacific J. Math. 1 (1951), 353–367.
-/

public section

noncomputable section

open Set Topology AbstractSimplicialComplex

namespace PartitionOfUnity

variable {ι X : Type*} [TopologicalSpace X]

section Nerve

variable {s : Set X} (ρ : PartitionOfUnity ι X s)

/-- The nerve of a partition of unity `ρ`: the abstract simplicial complex on `ι` whose faces are
the nonempty finite sets `t` of indices such that all `ρ i`, `i ∈ t`, are nonzero at a common
point, together with every singleton. -/
def nerve : AbstractSimplicialComplex ι :=
  PreAbstractSimplicialComplex.addSingletons ι
    (TauCeti.PreAbstractSimplicialComplex.ofGenerators (Set.range ρ.finsupport))

/-- A finite set of indices is a face of the nerve of `ρ` exactly when it is nonempty and the
functions `ρ i` it indexes are nonzero at a common point, or it is a singleton. -/
theorem mem_nerve_iff {t : Finset ι} :
    t ∈ ρ.nerve ↔ (t.Nonempty ∧ ∃ x, ∀ i ∈ t, ρ i x ≠ 0) ∨ ∃ i, t = {i} := by
  -- Mathlib states no membership lemma for `PreAbstractSimplicialComplex.addSingletons`, whose
  -- faces are by definition those of the precomplex together with the singletons.
  have h : t ∈ ρ.nerve ↔ t ∈ TauCeti.PreAbstractSimplicialComplex.ofGenerators
      (Set.range ρ.finsupport) ∨ ∃ i, t = {i} := Iff.rfl
  simp [h, TauCeti.PreAbstractSimplicialComplex.mem_ofGenerators, Finset.subset_iff]

/-- A nonempty finite set of indices whose functions are all nonzero at `x` is a face of the
nerve. -/
theorem mem_nerve_of_ne_zero {t : Finset ι} (ht : t.Nonempty) {x : X}
    (hx : ∀ i ∈ t, ρ i x ≠ 0) : t ∈ ρ.nerve :=
  (ρ.mem_nerve_iff).2 (Or.inl ⟨ht, x, hx⟩)

end Nerve

variable (ρ : PartitionOfUnity ι X)

/-- The barycentric coordinates `i ↦ ρ i x`, as a finitely supported function. -/
private def coords (x : X) : ι →₀ ℝ :=
  Finsupp.onFinset (ρ.finsupport x) (fun i => ρ i x) fun _ hi => (ρ.mem_finsupport x).2 hi

private theorem coords_apply (x : X) (i : ι) : ρ.coords x i = ρ i x :=
  Finsupp.onFinset_apply ..

private theorem support_coords (x : X) : (ρ.coords x).support = ρ.finsupport x := by
  ext i
  rw [Finsupp.mem_support_iff, coords_apply, mem_finsupport, Function.mem_support]

private theorem coords_mem (x : X) : ρ.coords x ∈ (standardGeometricComplex ρ.nerve).space := by
  classical
  refine TauCeti.mem_standardGeometricComplex_space_iff.2
    ⟨fun i => (ρ.coords_apply x i).symm ▸ ρ.nonneg i x, ?_, ?_⟩
  · rw [Finsupp.sum, support_coords]
    simp_rw [coords_apply]
    exact ρ.sum_finsupport (mem_univ x)
  · obtain ⟨i, hi⟩ := ρ.exists_pos (mem_univ x)
    refine ρ.mem_nerve_of_ne_zero ⟨i, ?_⟩ (x := x) fun j hj => ?_
    · rw [Finsupp.mem_support_iff, coords_apply]
      exact hi.ne'
    · rwa [Finsupp.mem_support_iff, coords_apply] at hj

/-- The point of the realization with barycentric coordinates `ρ i x`. -/
private def toNerveFun (x : X) : ρ.nerve.Realization :=
  ⟨ρ.coords x, ρ.coords_mem x⟩

private theorem coe_toNerveFun (x : X) : (ρ.toNerveFun x : ι →₀ ℝ) = ρ.coords x :=
  rfl

private theorem continuous_toNerveFun : Continuous ρ.toNerveFun :=
  continuous_of_forall_eventually_support_subset
    (fun i => by simpa only [coe_toNerveFun, coords_apply] using (ρ i).continuous)
    fun x₀ => ⟨ρ.fintsupport x₀, by
      simpa only [coe_toNerveFun, support_coords] using ρ.eventually_finsupport_subset x₀⟩

/-- The canonical map from `X` to the realization of the nerve of a partition of unity `ρ`,
sending `x` to the point with barycentric coordinates `ρ i x`. -/
def toNerve : C(X, ρ.nerve.Realization) :=
  ⟨ρ.toNerveFun, ρ.continuous_toNerveFun⟩

private theorem toNerve_apply (x : X) : ρ.toNerve x = ρ.toNerveFun x :=
  rfl

/-- The barycentric coordinates of `ρ.toNerve x` are the values `ρ i x`. -/
@[simp]
theorem toNerve_apply_coe (x : X) (i : ι) : ((ρ.toNerve x : ρ.nerve.Realization) : ι →₀ ℝ) i =
    ρ i x := by
  rw [toNerve_apply, coe_toNerveFun, coords_apply]

/-- The vertices carrying `ρ.toNerve x` are the indices `i` with `ρ i x ≠ 0`. -/
@[simp]
theorem support_toNerve_apply (x : X) :
    ((ρ.toNerve x : ρ.nerve.Realization) : ι →₀ ℝ).support = ρ.finsupport x := by
  rw [toNerve_apply, coe_toNerveFun, support_coords]

end PartitionOfUnity

end
