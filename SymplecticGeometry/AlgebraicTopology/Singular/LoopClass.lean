module

public import TauCeti.AlgebraicTopology.Homotopy.Hurewicz.One.Basic
import TauCeti.Topology.Connected.PathConnected

/-!
# Loops generate the first homology group

For any topological space `X`, path-connected or not, the first singular homology group
`H₁(X; R)`, for a coefficient ring `R ≅ ℤ`, is generated as an additive group by the homology
classes of loops (`TauCeti.HurewiczOne.H₁.closure_loopClass`), and so the first homology group of
the singular chain complex is generated by their images
(`TauCeti.HurewiczOne.closure_H₁AddEquivHomology_loopClass`). The loops may have their base
points in different path components of `X`.

The proof adapts the one of Tau Ceti's `TauCeti.HurewiczOne.hurewiczAddEquiv` (Hatcher,
Theorem 2A.1), and its private lemmas `loopChains_sub_mem_boundaries₁` and
`loopChains_mem_cycles₁`, with one base point chosen in each path component
(`TauCeti.exists_pathComponent_representative`) instead of a single base point.
Each point `y` is joined to the base point of its path component by a chosen path, and a singular
`1`-simplex `s` from `y` to `z` gives the loop that runs from the base point to `y`, along `s`,
and back from `z`. On a `1`-cycle, the chains of the chosen paths cancel, so the cycle is
homologous to the sum of the chains of these loops.

## Main results

* `TauCeti.HurewiczOne.H₁.closure_loopClass`: the classes of loops generate `H₁ R X`.
* `TauCeti.HurewiczOne.closure_H₁AddEquivHomology_loopClass`: the same for the first homology
  group of the singular chain complex.

## References

* A. Hatcher, *Algebraic Topology*, Theorem 2A.1.
-/

public section

noncomputable section

open CategoryTheory Simplicial TauCeti.TopCat

universe u

namespace TauCeti.HurewiczOne

variable {R : Type u} [Ring R] {X : TopCat.{u}}

/-- The chosen point of the path component of `y`. -/
private def basePoint (y : X) : X := (exists_pathComponent_representative (X := X)).choose y

private lemma basePoint_eq {y z : X} (h : Joined y z) : basePoint y = basePoint z :=
  (exists_pathComponent_representative (X := X)).choose_spec.2 h

/-- A chosen path from the base point of the path component of `y` to `y`. -/
private def pathTo (y : X) : Path (basePoint y) y :=
  ((exists_pathComponent_representative (X := X)).choose_spec.1 y).somePath

/-- The loop at the base point of the path component of a singular `1`-simplex that runs along
the chosen path to its source, along the simplex, and back from its target. -/
private def loopPath (s : (TopCat.toSSet.obj X) _⦋1⦌) :
    Path (basePoint (source₁ s)) (basePoint (source₁ s)) :=
  (pathTo (source₁ s)).trans ((path₁ s).trans
    ((pathTo (target₁ s)).symm.cast rfl (basePoint_eq ⟨path₁ s⟩)))

variable (R) in
/-- The `1`-chains of the chosen paths to the points of a `0`-chain. -/
private def pathChains : ((singularChains R).obj X).X 0 →ₗ[R] ((singularChains R).obj X).X 1 :=
  chainsDesc fun v ↦ pathChain R (pathTo (TopCat.toSSetObj₀Equiv v)).toContinuousMap

variable (R) in
/-- The `1`-chains of the loops through the simplices of a `1`-chain. -/
private def loopChains : ((singularChains R).obj X).X 1 →ₗ[R] ((singularChains R).obj X).X 1 :=
  chainsDesc fun s ↦ pathChain R (loopPath s).toContinuousMap

private lemma pathChain_loopPath_sub_mem_boundaries₁ (s : (TopCat.toSSet.obj X) _⦋1⦌) :
    pathChain R (loopPath s).toContinuousMap - simplexChain s 1 +
      (pathChain R (pathTo (target₁ s)).toContinuousMap -
        pathChain R (pathTo (source₁ s)).toContinuousMap) ∈ boundaries₁ R X := by
  set q := (pathTo (target₁ s)).symm.cast rfl (basePoint_eq ⟨path₁ s⟩)
  have hq : q.toContinuousMap = (pathTo (target₁ s)).symm.toContinuousMap := rfl
  have h₁ := pathChain_add_sub_trans_mem_boundaries₁ R (pathTo (source₁ s)) ((path₁ s).trans q)
  have h₂ := pathChain_add_sub_trans_mem_boundaries₁ R (path₁ s) q
  have h₃ := pathChain_add_symm_mem_boundaries₁ R (pathTo (target₁ s))
  have hs : pathChain R (path₁ s).toContinuousMap = simplexChain s 1 := by
    rw [pathChain, simplex₁_path₁]
  rw [hq] at h₂
  have := sub_mem (sub_mem h₃ h₂) h₁
  rw [hs] at this
  convert this using 1
  rw [loopPath]
  abel

private lemma loopChains_sub_mem_boundaries₁ (c : ((singularChains R).obj X).X 1) :
    loopChains R c - c + pathChains R (((singularChains R).obj X).d 1 0 c) ∈
      boundaries₁ R X := by
  have : (boundaries₁ R X).mkQ ∘ₗ (loopChains R - LinearMap.id +
      pathChains R ∘ₗ (((singularChains R).obj X).d 1 0).hom) = 0 :=
    singularChains_linearMap_ext fun s ↦ by
      rw [LinearMap.zero_apply, LinearMap.comp_apply, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, LinearMap.add_apply, LinearMap.sub_apply,
        LinearMap.id_apply, LinearMap.comp_apply]
      rw [singularChains_d_simplexChain (n := 0), Fin.sum_univ_two, map_add, map_zsmul, map_zsmul,
        pathChains, chainsDesc_simplexChain_one, chainsDesc_simplexChain_one,
        toSSetObj₀Equiv_δ_zero, toSSetObj₀Equiv_δ_one, loopChains, chainsDesc_simplexChain_one]
      convert pathChain_loopPath_sub_mem_boundaries₁ (R := R) s using 1
      simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul]
      abel
  exact (Submodule.Quotient.mk_eq_zero _).1 (LinearMap.congr_fun this c)

private lemma loopChains_mem_cycles₁ (c : ((singularChains R).obj X).X 1) :
    loopChains R c ∈ cycles₁ R X := by
  have : (((singularChains R).obj X).d 1 0).hom ∘ₗ loopChains R = 0 :=
    singularChains_linearMap_ext fun s ↦ by
      rw [LinearMap.comp_apply, loopChains, chainsDesc_simplexChain_one, LinearMap.zero_apply]
      exact pathChain_mem_cycles₁ R (loopPath s)
  exact mem_cycles₁ (LinearMap.congr_fun this c)

/-- **Loops generate the first homology group.** For a coefficient ring `R ≅ ℤ`, the homology
classes of loops, at all base points, generate `H₁ R X` as an additive group. The space `X` need
not be path-connected. -/
theorem H₁.closure_loopClass (e : R ≃+* ℤ) :
    AddSubgroup.closure (Set.range fun p : Σ x : X, Path x x ↦ loopClass R p.2) = ⊤ := by
  set L := AddSubgroup.closure (Set.range fun p : Σ x : X, Path x x ↦ loopClass R p.2)
  refine eq_top_iff.2 fun h _ ↦ ?_
  obtain ⟨z, rfl⟩ := H₁.mk_surjective h
  -- The class of the chain of loops through a `1`-chain lies in `L`, by linearity.
  let ψ : ((singularChains R).obj X).X 1 →+ H₁ R X ⧸ L :=
    (QuotientAddGroup.mk' L).comp (H₁.mk.comp
      ((loopChains R).codRestrict (cycles₁ R X) loopChains_mem_cycles₁).toAddMonoidHom)
  have hψ : ψ = 0 := singularChains_addMonoidHom_ext e fun s ↦ by
    simp only [ψ, AddMonoidHom.coe_comp, Function.comp_apply, LinearMap.toAddMonoidHom_coe,
      AddMonoidHom.zero_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
    refine AddSubgroup.subset_closure ⟨⟨_, loopPath s⟩, ?_⟩
    dsimp only
    rw [loopClass_def]
    congr 1
    ext1
    simp [loopChains]
  have hz : ((singularChains R).obj X).d 1 0 z = 0 := mem_cycles₁_iff.1 z.property
  have hmk : H₁.mk z = H₁.mk ⟨_, loopChains_mem_cycles₁ (R := R) z⟩ := by
    rw [H₁.mk_eq_mk_iff, ← neg_mem_iff, neg_sub]
    have := loopChains_sub_mem_boundaries₁ (R := R) (z : ((singularChains R).obj X).X 1)
    rwa [hz, map_zero, add_zero] at this
  rw [hmk, ← QuotientAddGroup.eq_zero_iff]
  exact DFunLike.congr_fun hψ (z : ((singularChains R).obj X).X 1)

/-- **Loops generate the first homology group of the singular chain complex.** For a coefficient
ring `R ≅ ℤ`, the images of the homology classes of loops, at all base points, generate the first
homology group of the singular chain complex of `X`. The space `X` need not be path-connected. -/
theorem closure_H₁AddEquivHomology_loopClass (e : R ≃+* ℤ) :
    AddSubgroup.closure (Set.range fun p : Σ x : X, Path x x ↦
      H₁AddEquivHomology R X (loopClass R p.2)) = ⊤ := by
  have := congrArg (AddSubgroup.map (H₁AddEquivHomology R X).toAddMonoidHom)
    (H₁.closure_loopClass (R := R) (X := X) e)
  rw [AddMonoidHom.map_closure, ← AddMonoidHom.range_eq_map,
    AddMonoidHom.range_eq_top.2 (H₁AddEquivHomology R X).surjective] at this
  convert this using 2
  ext h
  simp

end TauCeti.HurewiczOne

end
