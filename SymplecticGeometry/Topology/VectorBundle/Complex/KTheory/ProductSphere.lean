open Set CategoryTheory Projectivization

open scoped LinearAlgebra.Projectivization

namespace TauCeti.FiniteRankBundleCore

open SymplecticGeometry.ProjectiveLine

variable {𝕜 X : Type*} [NontriviallyNormedField 𝕜] [TopologicalSpace X]
  [CompactSpace X] [T2Space X] [NormedAlgebra ℝ 𝕜] [CompleteSpace 𝕜]
  (F : FiniteRankBundleCore 𝕜 (X × ℙ ℂ (Fin 2 → ℂ)))

/-! ### The restriction of a core to the product with a disc -/

/-- **A core is trivial along the affine line.** For `X` compact Hausdorff and a core `F` over
`X × ℙ ℂ (Fin 2 → ℂ)`, the pullback of `F` along the inverse of an affine chart in the second
factor is isomorphic to the pullback along the projection `X × (Fin 1 → ℂ) → X` of the restriction
of `F` to `X × {[1 : 1]}`. -/
theorem nonempty_pullback_affineChartMap_iso (i : Fin 2) :
    Nonempty (F.pullback (affineChartMap X i) ≅
      (F.pullback (prodMkOne X)).pullback ContinuousMap.fst) := by
  -- The affine line contracts to the coordinate `1` of `[1 : 1]`.
  obtain ⟨e⟩ := (F.pullback (affineChartMap X i)).nonempty_iso_pullback_fst (1 : Fin 1 → ℂ)
  have hk : (affineChartMap X i).comp ((ContinuousMap.id X).prodMk (.const X 1)) =
      prodMkOne X :=
    ContinuousMap.ext fun x ↦ by simp
  rw [pullback_comp F, hk] at e
  exact ⟨e⟩

/-- **A core is trivial over the product with a part of an affine open.** For `X` compact
Hausdorff, a core `F` over `X × ℙ ℂ (Fin 2 → ℂ)` and a set `S` inside the affine open `i` of the
projective line, the restriction of `F` to `X × S` is isomorphic to that of the pullback along the
projection of the restriction of `F` to `X × {[1 : 1]}`. -/
theorem nonempty_pullback_subtypeVal_iso_of_subset_affineOpen {i : Fin 2}
    {S : Set (ℙ ℂ (Fin 2 → ℂ))} (hS : S ⊆ affineOpen i) :
    Nonempty (F.pullback (ContinuousMap.subtypeVal (Prod.snd ⁻¹' S)) ≅
      ((F.pullback (prodMkOne X)).pullback ContinuousMap.fst).pullback
        (ContinuousMap.subtypeVal (Prod.snd ⁻¹' S))) := by
  -- The coordinates of `X × S` in `X × (Fin 1 → ℂ)`.
  let k : C(↥(Prod.snd ⁻¹' S : Set (X × ℙ ℂ (Fin 2 → ℂ))), X × (Fin 1 → ℂ)) :=
    ⟨fun w ↦ (w.val.1, affineChart i w.val.2),
      (continuous_fst.comp continuous_subtypeVal).prodMk
        (continuousOn_iff_continuous_domRestrict.1 ((continuousOn_affineChart i).mono hS) |>.comp
          ((continuous_snd.comp continuous_subtypeVal).subtype_mk fun w ↦ w.property))⟩
  have hk : (affineChartMap X i).comp k = ContinuousMap.subtypeVal (Prod.snd ⁻¹' S) :=
    ContinuousMap.ext fun w ↦ Prod.ext (by simp [affineChartMap_apply, k])
      (by simpa [affineChartMap_apply, k] using
        (affineChart i).left_inv (by rw [affineChart_source]; exact hS w.property))
  obtain ⟨e⟩ := F.nonempty_pullback_affineChartMap_iso i
  refine ⟨eqToIso ?_ ≪≫ (pullbackFunctor k).mapIso e ≪≫ eqToIso ?_⟩
  · rw [pullbackFunctor_obj, pullback_comp, hk]
  · rw [pullbackFunctor_obj, pullback_comp, pullback_comp, pullback_comp]
    exact congrArg F.pullback (ContinuousMap.ext fun _ ↦ rfl)

/-! ### Every core over `X × ℂP¹` is a clutching -/

/-- **Every bundle over `X × ℂP¹` is a clutching.** Let `X` be compact Hausdorff and `F` a
finite-rank core over `X × ℙ ℂ (Fin 2 → ℂ)`, and let `E` be its restriction to `X × {[1 : 1]}`,
the pullback of `F` along `x ↦ (x, [1 : 1])`. Then `F` is isomorphic to the clutching of `E` by
some automorphism `f` of the pullback of `E` to `X × Circle`. -/
theorem exists_iso_clutching :
    ∃ f : (F.pullback (prodMkOne X)).circlePullback ≅ (F.pullback (prodMkOne X)).circlePullback,
      Nonempty (F ≅ (F.pullback (prodMkOne X)).clutching f) := by
  obtain ⟨φ⟩ := F.nonempty_pullback_subtypeVal_iso_of_subset_affineOpen
    (S := innerDisc) innerDisc_subset_affineOpen
  obtain ⟨ψ⟩ := F.nonempty_pullback_subtypeVal_iso_of_subset_affineOpen
    (S := outerDisc) outerDisc_subset_affineOpen
  have hU : IsOpen (Prod.snd ⁻¹' innerDisc : Set (X × ℙ ℂ (Fin 2 → ℂ))) :=
    isOpen_innerDisc.preimage continuous_snd
  have hV : IsOpen (Prod.snd ⁻¹' outerDisc : Set (X × ℙ ℂ (Fin 2 → ℂ))) :=
    isOpen_outerDisc.preimage continuous_snd
  have hUV : (Prod.snd ⁻¹' innerDisc ∪ Prod.snd ⁻¹' outerDisc : Set (X × ℙ ℂ (Fin 2 → ℂ))) =
      univ := by
    rw [← preimage_union, innerDisc_union_outerDisc, preimage_univ]
  -- The pullbacks of `E` along the restrictions of the projection to `X × Circle`, through
  -- `circleToAnnulus`, and to the annulus part of `(X × ℙ ℂ (Fin 2 → ℂ)) × I`, through
  -- `annulusDeformation`, are its pullbacks along the projections.
  have hc : (((F.pullback (prodMkOne X)).pullback ContinuousMap.fst).pullback
      (ContinuousMap.subtypeVal (Prod.snd ⁻¹' innerDisc ∩ Prod.snd ⁻¹' outerDisc))).pullback
        (circleToAnnulus X) = (F.pullback (prodMkOne X)).pullback ContinuousMap.fst := by
    simp [pullback_comp]
  have hd : (((F.pullback (prodMkOne X)).pullback ContinuousMap.fst).pullback
      (ContinuousMap.subtypeVal (Prod.snd ⁻¹' innerDisc ∩ Prod.snd ⁻¹' outerDisc))).pullback
        (annulusDeformation X) =
      (((F.pullback (prodMkOne X)).pullback ContinuousMap.fst).pullback
        (ContinuousMap.fst : C((X × ℙ ℂ (Fin 2 → ℂ)) × unitInterval, X × ℙ ℂ (Fin 2 → ℂ)))).pullback
        (ContinuousMap.subtypeVal (Prod.fst ⁻¹' (Prod.snd ⁻¹' innerDisc) ∩
          Prod.fst ⁻¹' (Prod.snd ⁻¹' outerDisc))) := by
    simp [pullback_comp]
  -- The clutching function: the transition of `φ` and `ψ` on `X × Circle`.
  let f := eqToIso hc.symm ≪≫ (pullbackFunctor (circleToAnnulus X)).mapIso (glueTransition φ ψ) ≪≫
    eqToIso hc
  refine ⟨f, ?_⟩
  obtain ⟨e⟩ := nonempty_iso_glue_of_homotopic _ hU hV hUV
    (g₀ := glueTransition φ ψ) (g₁ := clutchingAut (F.pullback (prodMkOne X)) f)
    (eqToIso hd.symm ≪≫ (pullbackFunctor (annulusDeformation X)).mapIso (glueTransition φ ψ) ≪≫
      eqToIso hd)
    (fun w ↦ by
      ext v i
      simp [annulusDeformation_zero])
    (fun w ↦ by
      ext v i
      simp [f, annulusDeformation_one])
  exact ⟨isoGlue φ ψ hU hV hUV ≪≫ e⟩

/-- **Every bundle over `X × ℂP¹` is a clutching by a Laurent clutching function.** Let `X` be
compact Hausdorff and `F` a finite-rank complex core over `X × ℙ ℂ (Fin 2 → ℂ)`, and let `E` be its
restriction to `X × {[1 : 1]}`. Then there are `N : ℕ`, endomorphisms `a i` of `E` and an
automorphism `g` of the pullback of `E` to `X × Circle` whose underlying morphism is the Laurent
family `laurentHom N a`, with fibre map `∑_{|i| ≤ N} u ^ i • (a i).fiberMap x` at `(x, u)`, such
that `F` is isomorphic to the clutching of `E` by `g`. -/
theorem exists_iso_clutching_laurent (F : FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ))) :
    ∃ (N : ℕ) (a : ℤ → (F.pullback (prodMkOne X) ⟶ F.pullback (prodMkOne X)))
      (g : (F.pullback (prodMkOne X)).circlePullback ≅ (F.pullback (prodMkOne X)).circlePullback),
      g.hom = laurentHom N a ∧ Nonempty (F ≅ (F.pullback (prodMkOne X)).clutching g) := by
  obtain ⟨f, ⟨e⟩⟩ := F.exists_iso_clutching
  obtain ⟨N, a, g, hg, ⟨e'⟩⟩ := exists_iso_clutching_laurentHom f
  exact ⟨N, a, g, hg, ⟨e ≪≫ e'⟩⟩

end TauCeti.FiniteRankBundleCore

/-! ### The clutched lines `L m` -/

namespace TauCeti.FiniteRankBundleCore

open scoped unitInterval

variable {X : Type*} [TopologicalSpace X]

variable (X) in
/-- The cosine `cos (π t / 2)` of the angle of Hatcher's rotation at `((x, t), u)`. -/
private def rotationCos : C((X × I) × Circle, ℂ) :=
  ⟨fun b ↦ Complex.cos (Real.pi / 2 * (b.1.2 : ℝ)), by fun_prop⟩

variable (X) in
/-- The sine `sin (π t / 2)` of the angle of Hatcher's rotation at `((x, t), u)`. -/
private def rotationSin : C((X × I) × Circle, ℂ) :=
  ⟨fun b ↦ Complex.sin (Real.pi / 2 * (b.1.2 : ℝ)), by fun_prop⟩

private theorem rotationCos_sq_add_rotationSin_sq :
    rotationCos X ^ 2 + rotationSin X ^ 2 = 1 :=
  ContinuousMap.ext fun _ ↦ by simp [rotationCos, rotationSin]

/-- Hatcher's homotopy from `diag (u ^ m, u ^ n)` to `diag (u ^ (m + n), 1)`, as an automorphism
of the sum of two trivial lines over `(X × I) × Circle`: at `((x, t), u)`, with `R` the rotation by
`π t / 2`, it applies `diag (u ^ m, 1)`, then `R`, then `diag (1, u ^ n)`, then `R⁻¹`. -/
private def rotationHomotopyIso (m n : ℤ) :=
  whitneyMapIso (pullbackForgetTimeIso (circleZPowIso X m)) (Iso.refl _) ≪≫
    whitneyRotation _ (rotationCos X) (rotationSin X) rotationCos_sq_add_rotationSin_sq ≪≫
    whitneyMapIso (Iso.refl _) (pullbackForgetTimeIso (circleZPowIso X n)) ≪≫
    (whitneyRotation _ (rotationCos X) (rotationSin X) rotationCos_sq_add_rotationSin_sq).symm

private theorem fiberMap_rotationHomotopyIso_zero (m n : ℤ) (w : X × Circle) :
    (rotationHomotopyIso m n).hom.fiberMap ((w.1, 0), w.2) =
      (whitneyMapIsoPullback (circleZPowIso X m) (circleZPowIso X n)).hom.fiberMap w := by
  rw [fiberMap_whitneyMapIsoPullback_hom]
  -- At `t = 0` the rotation is the identity.
  have hc : rotationCos X ((w.1, 0), w.2) = 1 := by simp [rotationCos]
  have hs : rotationSin X ((w.1, 0), w.2) = 0 := by simp [rotationSin]
  simp only [rotationHomotopyIso, Iso.trans_hom, Iso.symm_hom, fiberMap_comp,
    fiberMap_whitneyRotation_hom, fiberMap_whitneyRotation_inv, hc, hs, zero_smul, one_smul,
    add_zero, sub_zero, ContinuousLinearMap.id_comp, ContinuousLinearMap.comp_id]
  rw [← fiberMap_comp, whitneyMapIso_hom, whitneyMapIso_hom, ← whitneyMap_comp, Iso.refl_hom,
    Category.id_comp, Category.comp_id, fiberMap_whitneyMap,
    fiberMap_pullbackForgetTimeIso_hom, fiberMap_pullbackForgetTimeIso_hom,
    fiberMap_circleZPowIso_hom, fiberMap_circleZPowIso_hom]
  -- The two sides differ only in the ranks of the pullbacks of the trivial line to
  -- `(X × I) × Circle` and to `X × Circle`, which are both `1` by definition of the pullback.
  rfl

private theorem fiberMap_rotationHomotopyIso_one (m n : ℤ) (w : X × Circle) :
    (rotationHomotopyIso m n).hom.fiberMap ((w.1, 1), w.2) =
      (whitneyMapIsoPullback (circleZPowIso X (m + n)) (circleZPowIso X 0)).hom.fiberMap w := by
  rw [fiberMap_whitneyMapIsoPullback_hom]
  -- At `t = 1` the rotation is the quarter turn `J`, which conjugates `diag (1, u ^ n)` to
  -- `diag (u ^ n, 1)`.
  have hc : rotationCos X ((w.1, 1), w.2) = 0 := by simp [rotationCos]
  have hs : rotationSin X ((w.1, 1), w.2) = 1 := by simp [rotationSin]
  simp only [rotationHomotopyIso, Iso.trans_hom, Iso.symm_hom, fiberMap_comp,
    fiberMap_whitneyRotation_hom, fiberMap_whitneyRotation_inv, hc, hs, zero_smul, one_smul,
    zero_add, zero_sub]
  rw [← fiberMap_neg, ← fiberMap_comp, ← fiberMap_comp, ← fiberMap_comp]
  simp only [whitneyMapIso_hom, Iso.refl_hom]
  rw [whitneyQuarterTurn_comp_whitneyMap_comp_neg, ← whitneyMap_comp, Category.comp_id,
    pullbackForgetTimeIso_hom, pullbackForgetTimeIso_hom, ← pullbackForgetTime_comp,
    fiberMap_whitneyMap, fiberMap_pullbackForgetTime, fiberMap_comp,
    fiberMap_circleZPowIso_hom, fiberMap_circleZPowIso_hom, fiberMap_circleZPowIso_hom,
    fiberMap_circleZPowIso_hom, fiberMap_id,
    ContinuousLinearMap.smul_comp, ContinuousLinearMap.id_comp, smul_smul,
    ← zpow_add₀ (Circle.coe_ne_zero _), add_comm n m, zpow_zero, one_smul]
  -- As at `t = 0`, the two sides differ only in ranks that agree by definition.
  rfl

/-- **The lines `L m` add up as their degrees.** Over a paracompact R₁ space `X`, for instance a
compact Hausdorff one, let `L m` be the line over `X × ℙ ℂ (Fin 2 → ℂ)` clutched from the trivial
line by `u ↦ u ^ m` (`circleZPowIso X m`). Then `L m ⊕ L n ≅ L (m + n) ⊕ L 0`. -/
theorem whitneySum_clutching_circleZPowIso [ParacompactSpace X] [R1Space X] (m n : ℤ) :
    Nonempty (whitneySum ((trivial ℂ X 1).clutching (circleZPowIso X m))
        ((trivial ℂ X 1).clutching (circleZPowIso X n)) ≅
      whitneySum ((trivial ℂ X 1).clutching (circleZPowIso X (m + n)))
        ((trivial ℂ X 1).clutching (circleZPowIso X 0))) := by
  obtain ⟨e⟩ := nonempty_iso_clutching_of_homotopic
    (E := whitneySum (trivial ℂ X 1) (trivial ℂ X 1))
    (f₀ := whitneyMapIsoPullback (circleZPowIso X m) (circleZPowIso X n))
    (f₁ := whitneyMapIsoPullback (circleZPowIso X (m + n)) (circleZPowIso X 0))
    (rotationHomotopyIso m n) (fiberMap_rotationHomotopyIso_zero m n)
    (fiberMap_rotationHomotopyIso_one m n)
  exact ⟨(clutchingWhitneySumIso _ _).symm ≪≫ e ≪≫ clutchingWhitneySumIso _ _⟩

end TauCeti.FiniteRankBundleCore

/-! ### Splitting a linear clutching function along its Riesz projection -/

namespace TauCeti.FiniteRankBundleCore

open MonoidalCategory SymplecticGeometry

variable {X : Type*} [TopologicalSpace X] {E : FiniteRankBundleCore ℂ X}
  (T : E ⟶ E) (h : ∀ x, ∀ z ∈ spectrum ℂ (T.fiberMap x), ‖z‖ ≠ 1)

/-- With `P` the Riesz projection of `T`, `‖u‖ = 1` and `0 ≤ t ≤ 1`, the map
`(u + t T) P + (t u + T) (1 - P)` is injective on each fibre: on the range of `P` the
eigenvalues of `T` lie in the open unit disc, and on its kernel outside the closed one. -/
private theorem eq_zero_of_unitDiscRieszProjection_homotopy (x : X) {u : ℂ} (hu : ‖u‖ = 1)
    {t : ℝ} (ht₀ : 0 ≤ t) (ht₁ : t ≤ 1) (v : Fin E.rank → ℂ)
    (hv : u • (unitDiscRieszProjection T h).fiberMap x v +
        (t : ℂ) • T.fiberMap x ((unitDiscRieszProjection T h).fiberMap x v) +
        ((t * u : ℂ) • (v - (unitDiscRieszProjection T h).fiberMap x v) +
        T.fiberMap x (v - (unitDiscRieszProjection T h).fiberMap x v)) = 0) :
    v = 0 := by
  have hpp := fiberMap_fiberMap_of_comp_self (unitDiscRieszProjection_comp_self T h) x
  have hpq (y : Fin E.rank → ℂ) :
      (unitDiscRieszProjection T h).fiberMap x (T.fiberMap x y) =
        T.fiberMap x ((unitDiscRieszProjection T h).fiberMap x y) := by
    rw [← fiberMap_comp_apply, ← fiberMap_comp_apply, unitDiscRieszProjection_comp_comm]
  set p := (unitDiscRieszProjection T h).fiberMap x
  set q := T.fiberMap x
  have hu0 : u ≠ 0 := by rintro rfl; simp at hu
  -- Applying `p` leaves the component `(u + t T) p v` in the range of `p`.
  have ha : u • p v + (t : ℂ) • q (p v) = 0 := by
    simpa [map_add, map_sub, map_smul, hpp, hpq] using congrArg p hv
  have ha0 : p v = 0 := by
    refine Submodule.disjoint_def.1
      (disjoint_ker_id_sub_smul_range_unitDiscRieszProjection T h x
        (w := -((t : ℂ) / u)) ?_) (p v) ?_ ⟨v, rfl⟩
    · rw [norm_neg, norm_div, hu, div_one, Complex.norm_real, Real.norm_of_nonneg ht₀]
      exact ht₁
    · have : p v = -((t : ℂ) / u) • q (p v) := by
        rw [neg_smul, eq_neg_iff_add_eq_zero, ← smul_right_inj hu0, smul_add, smul_smul,
          mul_div_cancel₀ _ hu0, smul_zero]
        exact ha
      rw [LinearMap.mem_ker, ContinuousLinearMap.coe_coe, sub_apply, ContinuousLinearMap.id_apply,
        smul_apply, ← this, sub_self]
  -- What remains is `(t u + T) v = 0` with `v` in the kernel of `p`.
  rw [ha0, sub_zero, smul_zero, map_zero, smul_zero, zero_add] at hv
  refine Submodule.disjoint_def.1
    (disjoint_ker_sub_smul_ker_unitDiscRieszProjection T h x (w := -((t * u : ℂ))) ?_) v ?_ ha0
  · rw [norm_neg, norm_mul, hu, mul_one, Complex.norm_real, Real.norm_of_nonneg ht₀]
    exact ht₁
  · rw [LinearMap.mem_ker]
    simpa [add_comm] using hv

/-- For an idempotent `P` of `E`, the automorphism `u P + (𝟙 E - P)` of the pullback of `E` to
`X × Circle`, with `u` the circle coordinate: it multiplies the range of `P` by `u` and is the
identity on the range of `𝟙 E - P`. -/
noncomputable def smulIdempotentAddIso {P : E ⟶ E} (hP : P ≫ P = P) :
    E.circlePullback ≅ E.circlePullback where
  hom := circleCoord X •
      pullbackMap P (ContinuousMap.fst : C(X × Circle, X)) +
    pullbackMap (𝟙 E - P) (ContinuousMap.fst : C(X × Circle, X))
  inv := ContinuousMap.laurentMonomial (-1) (1 : C(X, ℂ)) •
      pullbackMap P (ContinuousMap.fst : C(X × Circle, X)) +
    pullbackMap (𝟙 E - P) (ContinuousMap.fst : C(X × Circle, X))
  hom_inv_id := hom_ext fun w ↦ ContinuousLinearMap.ext fun y ↦ by
    -- As in `clutching_smulIdempotentAddIso`, `ContinuousLinearMap.id_apply` does not fire by
    -- itself on the coordinates of the pullback.
    have hid (y : Fin E.rank → ℂ) : ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) y = y :=
      ContinuousLinearMap.id_apply y
    simp [fiberMap_comp, fiberMap_add, fiberMap_smul, fiberMap_pullbackMap,
      fiberMap_fiberMap_of_comp_self hP, hid, smul_smul, Circle.coe_ne_zero]
  inv_hom_id := hom_ext fun w ↦ ContinuousLinearMap.ext fun y ↦ by
    -- As in `clutching_smulIdempotentAddIso`, `ContinuousLinearMap.id_apply` does not fire by
    -- itself on the coordinates of the pullback.
    have hid (y : Fin E.rank → ℂ) : ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) y = y :=
      ContinuousLinearMap.id_apply y
    simp [fiberMap_comp, fiberMap_add, fiberMap_smul, fiberMap_pullbackMap,
      fiberMap_fiberMap_of_comp_self hP, hid, smul_smul, Circle.coe_ne_zero]

@[simp]
theorem fiberMap_smulIdempotentAddIso_hom {P : E ⟶ E} (hP : P ≫ P = P) (w : X × Circle) :
    (smulIdempotentAddIso hP).hom.fiberMap w =
      (w.2 : ℂ) • P.fiberMap w.1 + (𝟙 E - P).fiberMap w.1 := by
  simp [smulIdempotentAddIso, fiberMap_add, fiberMap_smul, fiberMap_pullbackMap]

@[simp]
theorem fiberMap_smulIdempotentAddIso_inv {P : E ⟶ E} (hP : P ≫ P = P) (w : X × Circle) :
    (smulIdempotentAddIso hP).inv.fiberMap w =
      (w.2 : ℂ)⁻¹ • P.fiberMap w.1 + (𝟙 E - P).fiberMap w.1 := by
  simp [smulIdempotentAddIso, fiberMap_add, fiberMap_smul, fiberMap_pullbackMap]

/-- **Clutching by `u` on the range of an idempotent.** Let `P` be an idempotent endomorphism of
a complex core `E` over `X`, with `P` of constant rank `r` and `𝟙 E - P` of constant rank `s`.
Then the clutching of `E` by `u P + (𝟙 E - P)` (`smulIdempotentAddIso`) is isomorphic to the
Whitney sum of the pullback of the range of `P` twisted by the line
`(trivial ℂ X 1).clutching (circleZPowIso X 1)` and the pullback of the range of `𝟙 E - P`. -/
theorem clutching_smulIdempotentAddIso {P : E ⟶ E} (hP : P ≫ P = P) {r s : ℕ}
    (hr : ∀ x, Module.finrank ℂ (P.fiberMap x).range = r)
    (hs : ∀ x, Module.finrank ℂ ((𝟙 E - P).fiberMap x).range = s) :
    Nonempty (E.clutching (smulIdempotentAddIso hP) ≅
      whitneySum ((range P hr).pullback ContinuousMap.fst ⊗
          (trivial ℂ X 1).clutching (circleZPowIso X 1))
        ((range (𝟙 E - P) hs).pullback ContinuousMap.fst)) := by
  -- The fibre maps of the pullbacks below act on `Fin (E.pullback _).rank → ℂ`, on which
  -- `ContinuousLinearMap.id_apply` for `Fin E.rank → ℂ` does not fire by itself.
  have hid (y : Fin E.rank → ℂ) : ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) y = y :=
    ContinuousLinearMap.id_apply y
  -- Through the splitting of `E` along `P`, `u P + (𝟙 E - P)` is `u ⊕ 1`.
  obtain ⟨i₁⟩ := nonempty_iso_clutching_of_fiberMap_comp_eq (rangeWhitneySumIso hr hs hP)
    (rangeWhitneySumIso hr hs hP)
    (f := smulIdempotentAddIso hP)
    (f' := whitneyMapIsoPullback (circleZPowSMul 1 (Iso.refl _)) (Iso.refl _))
    fun w ↦ by
      have ha (y : Fin E.rank → ℂ) : (rangeRestrict P hr).fiberMap w.1 (P.fiberMap w.1 y) =
          (rangeRestrict P hr).fiberMap w.1 y := by
        rw [← fiberMap_comp_apply, comp_rangeRestrict_of_comp_self hr hP]
      have hb (y : Fin E.rank → ℂ) :
          (rangeRestrict (𝟙 E - P) hs).fiberMap w.1 (y - P.fiberMap w.1 y) =
            (rangeRestrict (𝟙 E - P) hs).fiberMap w.1 y := by
        have := fiberMap_comp_apply (𝟙 E - P) (rangeRestrict (𝟙 E - P) hs) w.1 y
        rwa [comp_rangeRestrict_of_comp_self hs (Idempotents.idem_of_id_sub_idem P hP),
          fiberMap_sub, fiberMap_id, sub_apply, hid, eq_comm] at this
      have hb' (y : Fin E.rank → ℂ) :
          (rangeRestrict (𝟙 E - P) hs).fiberMap w.1 (P.fiberMap w.1 y) = 0 := by
        have := hb (P.fiberMap w.1 y)
        rwa [fiberMap_fiberMap_of_comp_self hP, sub_self, map_zero, eq_comm] at this
      -- Both sides pair the corestrictions to the two range cores, read through
      -- `splitCoords`; it remains to compare their composites with `u P + (𝟙 E - P)`.
      have key (a : (Fin E.rank → ℂ) →L[ℂ] (Fin (range P hr).rank → ℂ))
          (b : (Fin E.rank → ℂ) →L[ℂ] (Fin (range (𝟙 E - P) hs).rank → ℂ))
          (d : (Fin E.rank → ℂ) →L[ℂ] (Fin E.rank → ℂ)) (u : ℂ)
          (ha : ∀ v, a (d v) = u • a v) (hb : ∀ v, b (d v) = b v) :
          ((splitCoords (𝕜 := ℂ) _ _).symm.toContinuousLinearMap.comp (a.prod b)).comp d =
            ((splitCoords (𝕜 := ℂ) _ _).symm.toContinuousLinearMap.comp
                (((u • ContinuousLinearMap.id ℂ _).prodMap (ContinuousLinearMap.id ℂ _)).comp
                  (splitCoords (𝕜 := ℂ) _ _).toContinuousLinearMap)).comp
              ((splitCoords (𝕜 := ℂ) _ _).symm.toContinuousLinearMap.comp (a.prod b)) := by
        ext1 v
        simp [ha, hb]
      simp only [fiberMap_smulIdempotentAddIso_hom, rangeWhitneySumIso_hom, fiberMap_whitneyLift,
        fiberMap_whitneyMapIsoPullback_hom, fiberMap_sub, fiberMap_circleZPowSMul_hom,
        Iso.refl_hom, fiberMap_id, zpow_one]
      refine key _ _ _ _ (fun v ↦ ?_) (fun v ↦ ?_)
      · simp only [add_apply, smul_apply, sub_apply, hid, map_add, map_smul, map_sub, ha,
          sub_self, add_zero]
      · simp only [add_apply, smul_apply, sub_apply, hid, map_add, map_smul, hb, hb', smul_zero,
          zero_add]
  obtain ⟨i₂⟩ := clutching_whitneySum (circleZPowSMul 1 (Iso.refl (range P hr).circlePullback))
    (Iso.refl (range (𝟙 E - P) hs).circlePullback)
  obtain ⟨i₃⟩ := clutching_circleZPowSMul 1 (Iso.refl (range P hr).circlePullback)
  exact ⟨i₁ ≪≫ i₂ ≪≫
    whitneyMapIso (i₃ ≪≫ whiskerRightIso (clutchingOneIso _) _) (clutchingOneIso _)⟩

/-- **Splitting a linear clutching function.** Let `X` be paracompact and R₁, for instance
compact Hausdorff, let `T` be an endomorphism of a complex core `E` over `X` with no eigenvalue of
norm `1` on any fibre, and let `P` be its Riesz projection, of constant rank `r`, with `𝟙 E - P`
of constant rank `s`. Over a connected base these ranks are constant
(`TauCeti.FiniteRankBundleCore.finrank_range_fiberMap_eq`). Then the clutching of `E` by the
family `(x, u) ↦ u + T_x` is isomorphic to the Whitney sum of the pullback of the range of `P`
twisted by the line `(trivial ℂ X 1).clutching (circleZPowIso X 1)`, clutched by `u`, and the
pullback of the range of `𝟙 E - P`. -/
theorem clutching_smul_add [ParacompactSpace X] [R1Space X] {r s : ℕ}
    (hr : ∀ x, Module.finrank ℂ ((unitDiscRieszProjection T h).fiberMap x).range = r)
    (hs : ∀ x, Module.finrank ℂ ((𝟙 E - unitDiscRieszProjection T h).fiberMap x).range = s)
    (g : E.circlePullback ≅ E.circlePullback)
    (hg : ∀ w : X × Circle,
      g.hom.fiberMap w = (w.2 : ℂ) • ContinuousLinearMap.id ℂ _ + T.fiberMap w.1) :
    Nonempty (E.clutching g ≅
      whitneySum ((range (unitDiscRieszProjection T h) hr).pullback ContinuousMap.fst ⊗
          (trivial ℂ X 1).clutching (circleZPowIso X 1))
        ((range (𝟙 E - unitDiscRieszProjection T h) hs).pullback ContinuousMap.fst)) := by
  set P := unitDiscRieszProjection T h
  have hP : P ≫ P = P := unitDiscRieszProjection_comp_self T h
  have hpq (x : X) (y : Fin E.rank → ℂ) :
      P.fiberMap x (T.fiberMap x y) = T.fiberMap x (P.fiberMap x y) := by
    rw [← fiberMap_comp_apply, ← fiberMap_comp_apply, unitDiscRieszProjection_comp_comm]
  -- The fibre maps of the pullbacks below act on `Fin (E.pullback _).rank → ℂ`, on which
  -- `ContinuousLinearMap.id_apply` for `Fin E.rank → ℂ` does not fire by itself.
  have hid (y : Fin E.rank → ℂ) : ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) y = y :=
    ContinuousLinearMap.id_apply y
  -- `S = P + T (1 - P)` is an automorphism of `E`.
  have hS : IsIso (P + (𝟙 E - P) ≫ T) := by
    refine isIso_of_injective_fiberMap _ fun x ↦ (injective_iff_map_eq_zero _).2 fun v hv ↦ ?_
    refine eq_zero_of_unitDiscRieszProjection_homotopy T h x (u := 1) (by simp) le_rfl
      zero_le_one v ?_
    simp only [fiberMap_add, fiberMap_comp_apply, fiberMap_sub, fiberMap_id, add_apply, sub_apply,
      hid] at hv
    simpa only [one_smul, Complex.ofReal_zero, zero_smul, zero_mul, add_zero, zero_add]
      using hv
  let S : E ≅ E := asIso (P + (𝟙 E - P) ≫ T)
  let D := smulIdempotentAddIso hP
  let g₀ := (pullbackFunctor ContinuousMap.fst).mapIso S ≪≫ D
  -- The segment from `g₀ = (u P + (1 - P)) (P + T (1 - P))` to `g = u + T` is invertible: at
  -- time `t` it is `(u + t T) P + (t u + T) (1 - P)`.
  have hH : IsIso (segmentHom g₀.hom g.hom) := by
    refine isIso_of_injective_fiberMap _ fun b ↦ (injective_iff_map_eq_zero _).2 fun v hv ↦ ?_
    refine eq_zero_of_unitDiscRieszProjection_homotopy T h b.1.1 (u := b.2) (by simp)
      b.1.2.property.1 b.1.2.property.2 v ?_
    rw [← hv, fiberMap_segmentHom, hg]
    simp only [g₀, S, D, Iso.trans_hom, Functor.mapIso_hom, asIso_hom, fiberMap_comp,
      fiberMap_smulIdempotentAddIso_hom, fiberMap_add, fiberMap_pullbackMap, fiberMap_sub,
      fiberMap_id, ContinuousMap.fst_apply, add_apply, sub_apply, smul_apply,
      ContinuousLinearMap.comp_apply, map_add, map_sub, fiberMap_fiberMap_of_comp_self hP, hpq, hid]
    module
  obtain ⟨i₁⟩ := E.nonempty_iso_clutching_of_homotopic (asIso (segmentHom g₀.hom g.hom))
    (fiberMap_segmentHom_zero _ _) (fiberMap_segmentHom_one _ _)
  obtain ⟨i₂⟩ := E.nonempty_iso_clutching_pullback_trans D S
  -- What remains is the clutching by `u P + (𝟙 E - P)`.
  obtain ⟨i₃⟩ := clutching_smulIdempotentAddIso hP hr hs
  exact ⟨i₁.symm ≪≫ i₂ ≪≫ i₃⟩

/-- If an automorphism `g` of the pullback of `E` to `X × Circle` has fibre map `u + T(x)` at
`(x, u)`, then at no point `x` of `X` does `T(x)` have an eigenvalue of norm `1`. -/
theorem norm_ne_one_of_mem_spectrum_fiberMap
    (g : E.circlePullback ≅ E.circlePullback)
    (hg : ∀ w : X × Circle,
      g.hom.fiberMap w = (w.2 : ℂ) • ContinuousLinearMap.id ℂ _ + T.fiberMap w.1) :
    ∀ x, ∀ z ∈ spectrum ℂ (T.fiberMap x), ‖z‖ ≠ 1 := by
  intro x z hz hz1
  refine (spectrum.mem_iff.1 hz) ?_
  let u : Circle := { val := -z, property := mem_sphere_zero_iff_norm.2 (by rwa [norm_neg]) }
  have hu : IsUnit ((-z) • ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) + T.fiberMap x) := by
    rw [← hg (x, u)]
    exact ⟨(isoFiberEquiv g (x, u)).toUnit, toContinuousLinearMap_isoFiberEquiv g (x, u)⟩
  rw [Algebra.algebraMap_eq_smul_one, ContinuousLinearMap.one_def, sub_eq_add_neg,
    ← neg_neg (z • _), ← neg_smul, ← neg_add]
  exact hu.neg

/-- **Splitting a linear clutching function with any leading coefficient.** Let `X` be compact,
Hausdorff and preconnected, `E` a complex core over `X`, `a b : E ⟶ E`, and `g` an automorphism of
the pullback of `E` to `X × Circle` with fibre map `u • a(x) + b(x)` at `(x, u)`. Then there are
complex cores `E₁` and `E₂` over `X` such that the clutching of `E` by `g` is isomorphic to the
Whitney sum of the pullback of `E₁` twisted by the line
`(trivial ℂ X 1).clutching (circleZPowIso X 1)`, clutched by `u`, and the pullback of `E₂`. -/
theorem exists_nonempty_clutching_iso_whitneySum_of_linear [CompactSpace X] [T2Space X]
    [PreconnectedSpace X] {a b : E ⟶ E}
    {g : E.circlePullback ≅ E.circlePullback}
    (hg : ∀ w : X × Circle, g.hom.fiberMap w = (w.2 : ℂ) • a.fiberMap w.1 + b.fiberMap w.1) :
    ∃ E₁ E₂ : FiniteRankBundleCore ℂ X, Nonempty (E.clutching g ≅
      whitneySum (E₁.pullback ContinuousMap.fst ⊗ (trivial ℂ X 1).clutching (circleZPowIso X 1))
        (E₂.pullback ContinuousMap.fst)) := by
  -- Move to a linear clutching function `u A + B` with `A` invertible.
  obtain ⟨t, -, -, hA, g', hg', ⟨i₁⟩⟩ := exists_isIso_nonempty_iso_clutching_linear hg
  set A := a + ContinuousMap.const X (t : ℂ) • b
  set B := ContinuousMap.const X (t : ℂ) • a + b
  -- Divide by `A`: `k = A⁻¹ g'` has fibre map `u + T` with `T = A⁻¹ B`.
  let φ : E ≅ E := asIso A
  let k := g' ≪≫ (pullbackFunctor ContinuousMap.fst).mapIso φ.symm
  have hk : k ≪≫ (pullbackFunctor ContinuousMap.fst).mapIso φ = g' := by
    rw [Iso.trans_assoc, ← Functor.mapIso_trans, Iso.symm_self_id, Functor.mapIso_refl,
      Iso.trans_refl]
  obtain ⟨i₂⟩ := E.nonempty_iso_clutching_trans_pullback k φ
  rw [hk] at i₂
  let T : E ⟶ E := B ≫ inv A
  have hAA (x : X) (v : Fin E.rank → ℂ) : (inv A).fiberMap x (A.fiberMap x v) = v :=
    congrArg (· v) (fiberMap_hom_inv_id φ x)
  -- The fibre maps of the pullbacks act on `Fin (E.pullback _).rank → ℂ`, on which
  -- `ContinuousLinearMap.id_apply` for `Fin E.rank → ℂ` does not fire by itself.
  have hid (y : Fin E.rank → ℂ) : ContinuousLinearMap.id ℂ (Fin E.rank → ℂ) y = y :=
    ContinuousLinearMap.id_apply y
  have hkT (w : X × Circle) :
      k.hom.fiberMap w = (w.2 : ℂ) • ContinuousLinearMap.id ℂ _ + T.fiberMap w.1 := by
    ext1 v
    simp only [k, φ, T, Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom, asIso_inv,
      fiberMap_comp, fiberMap_pullbackMap, ContinuousMap.fst_apply, hg',
      ContinuousLinearMap.comp_apply, add_apply, smul_apply, map_add, map_smul, hAA]
    rw [hid]
  -- `u + T` is invertible on the circle, so `T` has no eigenvalue of norm `1`.
  have h := norm_ne_one_of_mem_spectrum_fiberMap T k hkT
  -- The Riesz projection of `T` and its complement have constant rank.
  set P := unitDiscRieszProjection T h
  have hP : P ≫ P = P := unitDiscRieszProjection_comp_self T h
  obtain ⟨r, hr⟩ := (isLocallyConstant_finrank_range_fiberMap hP).exists_eq_const
  obtain ⟨s, hs⟩ :=
    (isLocallyConstant_finrank_range_fiberMap
      (Idempotents.idem_of_id_sub_idem P hP)).exists_eq_const
  obtain ⟨i₃⟩ := clutching_smul_add T h (congrFun hr) (congrFun hs) k hkT
  exact ⟨_, _, ⟨i₁ ≪≫ i₂ ≪≫ i₃⟩⟩

end TauCeti.FiniteRankBundleCore

/-! ### The classes of the lines `L m` in `K(X × ℂP¹)` -/

namespace TauCeti.SplitK0

open FiniteRankBundleCore

variable {X : Type} [TopologicalSpace X]

/-- The line `L 0`, clutched from the trivial line by the constant `1`, has the class `1`. -/
@[simp]
theorem of_clutching_circleZPowIso_zero :
    (of ((trivial ℂ X 1).clutching (circleZPowIso X 0)) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) = 1 := by
  rw [circleZPowIso_zero, of_congr (clutchingOneIso _), one_def]
  exact of_congr (eqToIso (pullback_tensorUnit _))

/-- The line `L (-1)`, clutched from the trivial line by `u ↦ u⁻¹`, has the class `[H]` of the
pullback of the tautological line of `ℙ ℂ (Fin 2 → ℂ)`. -/
theorem of_clutching_circleZPowIso_neg_one :
    (of ((trivial ℂ X 1).clutching (circleZPowIso X (-1))) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) =
      of ((Projectivization.tautologicalCore ℂ (Fin 2 → ℂ)).pullback ContinuousMap.snd) :=
  of_congr (clutchingZIso X)

variable [ParacompactSpace X] [R1Space X]

/-- **The class of `L m`.** Over a paracompact R₁ space `X`, the line over `X × ℙ ℂ (Fin 2 → ℂ)`
clutched from the trivial line by `u ↦ u ^ m` has the class `1 + m • (1 - [H])`, with `[H]` the
class of the pullback of the tautological line. -/
theorem of_clutching_circleZPowIso (m : ℤ) :
    (of ((trivial ℂ X 1).clutching (circleZPowIso X m)) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) =
      1 + m • (1 - of ((Projectivization.tautologicalCore ℂ (Fin 2 → ℂ)).pullback
        ContinuousMap.snd)) := by
  have key (m n : ℤ) : (of ((trivial ℂ X 1).clutching (circleZPowIso X m)) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) +
      of ((trivial ℂ X 1).clutching (circleZPowIso X n)) =
      of ((trivial ℂ X 1).clutching (circleZPowIso X (m + n))) + 1 := by
    obtain ⟨e⟩ := whitneySum_clutching_circleZPowIso (X := X) m n
    rw [← of_whitneySum, of_congr e, of_whitneySum, of_clutching_circleZPowIso_zero]
  have h₁ := key 1 (-1)
  rw [of_clutching_circleZPowIso_neg_one, show (1 : ℤ) + -1 = 0 by norm_num,
    of_clutching_circleZPowIso_zero] at h₁
  induction m using Int.induction_on with
  | zero => simp
  | succ k ih =>
    have h := key k 1
    rw [add_smul, one_smul]
    linear_combination (norm := abel) -h + ih + h₁
  | pred k ih =>
    have h := key (-(k : ℤ) - 1) 1
    rw [show -(k : ℤ) - 1 + 1 = -k by ring] at h
    rw [sub_smul, one_smul]
    linear_combination (norm := abel) h + ih - h₁

/-- **`[H⁻¹] = 2 - [H]`.** Over a paracompact R₁ space `X`, the line over `X × ℙ ℂ (Fin 2 → ℂ)`
clutched from the trivial line by `u ↦ u`, the inverse of the pullback `H` of the tautological
line, has the class `2 - [H]`. -/
theorem of_clutching_circleZPowIso_one :
    (of ((trivial ℂ X 1).clutching (circleZPowIso X 1)) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) =
      2 - of ((Projectivization.tautologicalCore ℂ (Fin 2 → ℂ)).pullback ContinuousMap.snd) := by
  rw [of_clutching_circleZPowIso, one_smul, ← add_sub_assoc, one_add_one_eq_two]

/-- Over a paracompact R₁ space `X`, the class of every line `L m` clutched from the trivial line
by `u ↦ u ^ m` lies in the additive subgroup of `K(X × ℂP¹)` generated by `1` and `[H]`. -/
theorem of_clutching_circleZPowIso_mem_closure (m : ℤ) :
    (of ((trivial ℂ X 1).clutching (circleZPowIso X m)) :
      SplitK0 (FiniteRankBundleCore ℂ (X × ℙ ℂ (Fin 2 → ℂ)))) ∈
      AddSubgroup.closure {1,
        of ((Projectivization.tautologicalCore ℂ (Fin 2 → ℂ)).pullback ContinuousMap.snd)} := by
  rw [of_clutching_circleZPowIso]
  exact add_mem (AddSubgroup.subset_closure (by simp)) (zsmul_mem (sub_mem
    (AddSubgroup.subset_closure (by simp)) (AddSubgroup.subset_closure (by simp))) m)

end TauCeti.SplitK0

