module

public import Mathlib.GroupTheory.PresentedGroup
public import TauCeti.GroupTheory.SurfaceGroup.Basic
import TauCeti.GroupTheory.PresentedGroup

/-!
# Closed surface groups modulo the `b`-generators and words in the `a`-generators

Let `S⁺(g, 0) = TauCeti.SurfaceGroup.Orientable g 0` be the fundamental group of the closed
orientable surface of genus `g`, generated by `a k` and `b k` for `k : Fin g` subject to
`[a₁, b₁] ⋯ [a_g, b_g] = 1`. Given words `w j` in `g` letters, kill every `b k` and every word
`w j` read in the `a k`. Once the `b k` are trivial the surface relator is trivial too, so the
quotient is the group presented by the `g` letters and the relators `w j`.

## Main definitions

* `TauCeti.SurfaceGroup.Orientable.bWordsNormalClosure`: the normal closure in `S⁺(g, 0)` of the
  `b k` and of the words `w j` read in the `a k`.
* `TauCeti.SurfaceGroup.Orientable.quotientEquivPresentedGroup`: the isomorphism
  `S⁺(g, 0) ⧸ bWordsNormalClosure w ≃* PresentedGroup (Set.range w)`, sending the class of `a k`
  to `PresentedGroup.of k` and the class of `b k` to `1`.

Both directions come from universal properties: `TauCeti.SurfaceGroup.Orientable.lift` and
`QuotientGroup.lift` one way, `PresentedGroup.toGroup` the other. This is the group theory of
Gompf's realization of finitely presented groups as fundamental groups of symplectic
four-manifolds [Gompf1995]; see [McDuffSalamon2017, Theorem 7.2.8].

## References

* [R. E. Gompf, *A new construction of symplectic manifolds*][Gompf1995]
* [D. McDuff and D. Salamon, *Introduction to Symplectic Topology*][McDuffSalamon2017],
  Theorem 7.2.8.
-/

public section

namespace TauCeti

namespace SurfaceGroup

namespace Orientable

variable {g : ℕ} {J : Type*} (w : J → FreeGroup (Fin g))

/-- The normal closure in the closed surface group `S⁺(g, 0)` of all generators `b k` and of the
words `w j` read in the generators `a k`. -/
def bWordsNormalClosure : Subgroup (Orientable g 0) :=
  Subgroup.normalClosure (Set.range (b g 0) ∪ Set.range fun j ↦ FreeGroup.lift (a g 0) (w j))

theorem bWordsNormalClosure_def :
    bWordsNormalClosure w =
      Subgroup.normalClosure
        (Set.range (b g 0) ∪ Set.range fun j ↦ FreeGroup.lift (a g 0) (w j)) :=
  (rfl)

instance bWordsNormalClosure_normal : (bWordsNormalClosure w).Normal :=
  Subgroup.normalClosure_normal

/-- Each generator `b k` lies in `bWordsNormalClosure w`. -/
theorem b_mem_bWordsNormalClosure (k : Fin g) : b g 0 k ∈ bWordsNormalClosure w :=
  Subgroup.subset_normalClosure (.inl ⟨k, rfl⟩)

/-- Each word `w j`, read in the generators `a k`, lies in `bWordsNormalClosure w`. -/
theorem lift_a_mem_bWordsNormalClosure (j : J) :
    FreeGroup.lift (a g 0) (w j) ∈ bWordsNormalClosure w :=
  Subgroup.subset_normalClosure (.inr ⟨j, rfl⟩)

/-- The universal property of `bWordsNormalClosure w`: it lies in a normal subgroup `N` if and only
if `N` contains every generator `b k` and every word `w j` read in the generators `a k`. -/
theorem bWordsNormalClosure_le_iff {N : Subgroup (Orientable g 0)} [N.Normal] :
    bWordsNormalClosure w ≤ N ↔
      (∀ k, b g 0 k ∈ N) ∧ ∀ j, FreeGroup.lift (a g 0) (w j) ∈ N := by
  rw [bWordsNormalClosure_def, ← Subgroup.normalClosure_subset_iff, Set.union_subset_iff,
    Set.range_subset_iff, Set.range_subset_iff]
  simp only [SetLike.mem_coe]

/-- The homomorphism `S⁺(g, 0) →* PresentedGroup (Set.range w)` sending `a k` to the generator `k`
and `b k` to `1`. It is a step of `quotientEquivPresentedGroup`. -/
private def toPresentedGroup : Orientable g 0 →* PresentedGroup (Set.range w) :=
  lift PresentedGroup.of 1 Fin.elim0 <|
    (orientableWord_of_commute (β := 1) (fun _ ↦ Commute.one_right _) _).trans (by simp)

private theorem bWordsNormalClosure_le_ker :
    bWordsNormalClosure w ≤ (toPresentedGroup w).ker := by
  refine (bWordsNormalClosure_le_iff w).2 ⟨fun k ↦ by simp [toPresentedGroup], fun j ↦ ?_⟩
  rw [MonoidHom.mem_ker, ← MonoidHom.comp_apply,
    FreeGroup.lift_unique (f := PresentedGroup.of) _ fun k ↦ by simp [toPresentedGroup],
    PresentedGroup.lift_of_eq_mk]
  exact (QuotientGroup.eq_one_iff _).2 (Subgroup.subset_normalClosure ⟨j, rfl⟩)

/-- The homomorphism `PresentedGroup (Set.range w) →* S⁺(g, 0) ⧸ bWordsNormalClosure w` sending the
generator `k` to the class of `a k`. It is a step of `quotientEquivPresentedGroup`. -/
private def ofPresentedGroup :
    PresentedGroup (Set.range w) →* Orientable g 0 ⧸ bWordsNormalClosure w :=
  PresentedGroup.toGroup (f := fun k ↦ (a g 0 k : Orientable g 0 ⧸ bWordsNormalClosure w)) <| by
    rintro _ ⟨j, rfl⟩
    rw [← (FreeGroup.lift_unique ((QuotientGroup.mk' _).comp (FreeGroup.lift (a g 0)))
      fun k ↦ by simp), MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    exact lift_a_mem_bWordsNormalClosure w j

/-- **A closed surface group modulo the `b`-generators and words in the `a`-generators.** For
words `w j` in `g` letters, the closed surface group `S⁺(g, 0)` modulo the normal closure of its
generators `b k` and of the words `w j` read in its generators `a k` is the group presented by the
`g` letters and the relators `w j`. -/
def quotientEquivPresentedGroup :
    Orientable g 0 ⧸ bWordsNormalClosure w ≃* PresentedGroup (Set.range w) :=
  MonoidHom.toMulEquiv (QuotientGroup.lift _ _ (bWordsNormalClosure_le_ker w))
    (ofPresentedGroup w)
    (QuotientGroup.monoidHom_ext _ <| hom_ext
      (fun k ↦ by simp [toPresentedGroup, ofPresentedGroup])
      (fun k ↦ by
        simpa [toPresentedGroup] using
          ((QuotientGroup.eq_one_iff _).2 (b_mem_bWordsNormalClosure w k)).symm)
      (fun j ↦ j.elim0))
    (PresentedGroup.ext fun k ↦ by simp [toPresentedGroup, ofPresentedGroup])

@[simp]
theorem quotientEquivPresentedGroup_a (k : Fin g) :
    quotientEquivPresentedGroup w (a g 0 k) = PresentedGroup.of k := by
  simp [quotientEquivPresentedGroup, toPresentedGroup]

@[simp]
theorem quotientEquivPresentedGroup_b (k : Fin g) :
    quotientEquivPresentedGroup w (b g 0 k) = 1 := by
  simp [quotientEquivPresentedGroup, toPresentedGroup]

@[simp]
theorem quotientEquivPresentedGroup_symm_of (k : Fin g) :
    (quotientEquivPresentedGroup w).symm (PresentedGroup.of k) = a g 0 k := by
  rw [MulEquiv.symm_apply_eq, quotientEquivPresentedGroup_a]

end Orientable

end SurfaceGroup

end TauCeti

end
