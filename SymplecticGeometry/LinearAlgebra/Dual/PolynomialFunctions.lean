module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.LinearAlgebra.Dual.Basis
public import Mathlib.LinearAlgebra.FreeModule.Finite.Basic

/-!
# Polynomial functions on a module

For a module `M` over a commutative semiring `R`, the polynomial functions on `M` are the
subalgebra of `M → R` generated by the linear functionals on `M`. When `M` has a finite basis
`b`, they are the functions `p ↦ P (b.equivFun p)` for the multivariate polynomials `P` over `R`
in the indices of `b`, that is, the range of the algebra map `MvPolynomial ι R → (M → R)` that
sends the variable `X i` to the `i`-th coordinate function of `b`. The subalgebra itself does not
depend on a basis, so membership carries over from one basis to another.

The description by a basis, `Module.Basis.polynomialFunctions_eq_range_aeval` and
`Module.Basis.mem_polynomialFunctions_iff`, together with `@[simp]` on the membership of the
generators, adapts Tau Ceti's `TauCeti.Matrix.GeneralLinearGroup.polynomialFunctions`,
`TauCeti.Matrix.GeneralLinearGroup.mem_polynomialFunctions` and
`TauCeti.Matrix.GeneralLinearGroup.entry_mem_polynomialFunctions`
(`TauCeti/LinearAlgebra/Matrix/GeneralLinearGroup/PolynomialFunctions/Basic.lean`) from the
entries of an invertible matrix to the coordinates of a basis.

## Main definitions

* `Module.polynomialFunctions R M`: the subalgebra of `M → R` generated by the linear
  functionals on `M`.

## Main results

* `Module.linearMap_mem_polynomialFunctions`: linear functionals are polynomial functions.
* `Module.comp_linearMap_mem_polynomialFunctions`: the composite of a polynomial function with a
  linear map is a polynomial function.
* `Module.Basis.polynomialFunctions_eq_range_aeval`: for a finite basis `b`, the polynomial
  functions are the polynomials in the coordinate functions of `b`.
* `Module.Basis.mem_polynomialFunctions_iff`: `f` is a polynomial function exactly when
  `f p = P (b.equivFun p)` for some `P`.
* `Module.bilin_apply_mem_polynomialFunctions`: `p ↦ β (f p) (g p)` is a polynomial function for
  a bilinear form `β` whose left argument ranges over a finite free module, if `f` and `g` are
  polynomial maps, in the sense that their composites with linear functionals are polynomial
  functions.
-/

public section

noncomputable section

namespace Module

variable (R M : Type*) [CommSemiring R] [AddCommMonoid M] [Module R M]

/-- The polynomial functions on the module `M`: the subalgebra of `M → R` generated by the
linear functionals on `M`. -/
def polynomialFunctions : Subalgebra R (M → R) :=
  Algebra.adjoin R (Set.range fun ℓ : Dual R M ↦ ⇑ℓ)

theorem polynomialFunctions_def :
    polynomialFunctions R M = Algebra.adjoin R (Set.range fun ℓ : Dual R M ↦ ⇑ℓ) :=
  (rfl)

variable {R M}

/-- Every linear functional on `M` is a polynomial function. -/
@[simp]
theorem linearMap_mem_polynomialFunctions (ℓ : Dual R M) : ⇑ℓ ∈ polynomialFunctions R M :=
  Algebra.subset_adjoin ⟨ℓ, rfl⟩

/-- The composite `f ∘ L` of a polynomial function `f` on `N` with a linear map
`L : M →ₗ[R] N` is a polynomial function on `M`. -/
theorem comp_linearMap_mem_polynomialFunctions {N : Type*} [AddCommMonoid N] [Module R N]
    (L : M →ₗ[R] N) {f : N → R} (hf : f ∈ polynomialFunctions R N) :
    f ∘ L ∈ polynomialFunctions R M := by
  rw [polynomialFunctions_def] at hf
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    obtain ⟨ℓ, rfl⟩ := hf
    exact linearMap_mem_polynomialFunctions (ℓ ∘ₗ L)
  | algebraMap r => exact Subalgebra.algebraMap_mem _ r
  | add f g _ _ hf hg => exact Subalgebra.add_mem _ hf hg
  | mul f g _ _ hf hg => exact Subalgebra.mul_mem _ hf hg

/-- For a bilinear form `β` whose left argument ranges over a finite free module, the function
`p ↦ β (f p) (g p)` is a polynomial function on `M` if the composites of `f` and of `g` with
every linear functional are. -/
theorem bilin_apply_mem_polynomialFunctions {W₁ W₂ : Type*} [AddCommMonoid W₁] [Module R W₁]
    [Module.Free R W₁] [Module.Finite R W₁] [AddCommMonoid W₂] [Module R W₂]
    (β : W₁ →ₗ[R] W₂ →ₗ[R] R) {f : M → W₁} {g : M → W₂}
    (hf : ∀ ℓ : Dual R W₁, (fun p ↦ ℓ (f p)) ∈ polynomialFunctions R M)
    (hg : ∀ ℓ : Dual R W₂, (fun p ↦ ℓ (g p)) ∈ polynomialFunctions R M) :
    (fun p ↦ β (f p) (g p)) ∈ polynomialFunctions R M := by
  let c := Module.Free.chooseBasis R W₁
  have hβ : (fun p ↦ β (f p) (g p)) =
      ∑ i, (fun p ↦ c.coord i (f p)) * fun p ↦ β (c i) (g p) := by
    ext p
    rw [← LinearMap.flip_apply (f := β), ← c.sum_dual_apply_smul_coord (β.flip (g p))]
    simp [mul_comm]
  rw [hβ]
  exact Subalgebra.sum_mem _ fun i _ ↦ Subalgebra.mul_mem _ (hf _) (hg _)

namespace Basis

variable {ι : Type*} [Finite ι] (b : Basis ι R M)

/-- For a finite basis `b` of `M`, the polynomial functions on `M` are the polynomials in the
coordinate functions of `b`. -/
theorem polynomialFunctions_eq_range_aeval :
    polynomialFunctions R M = (MvPolynomial.aeval fun i ↦ ⇑(b.coord i)).range := by
  have := Fintype.ofFinite ι
  rw [← Algebra.adjoin_range_eq_range_aeval, polynomialFunctions_def]
  refine le_antisymm (Algebra.adjoin_le (Set.range_subset_iff.2 fun ℓ ↦ ?_))
    (Algebra.adjoin_mono (Set.range_subset_iff.2 fun i ↦ ⟨b.coord i, rfl⟩))
  rw [SetLike.mem_coe, ← b.sum_dual_apply_smul_coord ℓ, LinearMap.coe_sum]
  exact Subalgebra.sum_mem _ fun i _ ↦
    Subalgebra.smul_mem _ (Algebra.subset_adjoin (Set.mem_range_self i)) _

/-- For a finite basis `b` of `M`, a function is a polynomial function on `M` exactly when it is
`p ↦ MvPolynomial.eval (b.equivFun p) P` for a polynomial `P`. -/
theorem mem_polynomialFunctions_iff {f : M → R} :
    f ∈ polynomialFunctions R M ↔
      ∃ P : MvPolynomial ι R, ∀ p, MvPolynomial.eval (b.equivFun p) P = f p := by
  have h (P : MvPolynomial ι R) (p : M) :
      MvPolynomial.aeval (fun i ↦ ⇑(b.coord i)) P p = MvPolynomial.eval (b.equivFun p) P := by
    simpa [MvPolynomial.coe_aeval_eq_eval, Basis.equivFun_apply] using
      MvPolynomial.comp_aeval_apply (f := fun i ↦ ⇑(b.coord i))
        (φ := Pi.evalAlgHom R (fun _ : M ↦ R) p) (p := P)
  simp only [b.polynomialFunctions_eq_range_aeval, AlgHom.mem_range, funext_iff, h]

end Basis

end Module

end
